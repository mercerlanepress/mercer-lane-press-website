---
import BaseLayout from './BaseLayout.astro'; import Breadcrumbs from '../components/Breadcrumbs.astro';
const { entry } = Astro.props; const { title, description, published, related } = entry.data;
const url = new URL(`/5g-home-internet/${entry.id}/`, Astro.site).href;
const schema = {'@context':'https://schema.org','@type':'Article',headline:title,description,datePublished:published.toISOString().slice(0,10),author:{'@type':'Person',name:'Mercer Lane',url:'https://mercerlanepress.com/authors/mercer-lane/'},publisher:{'@type':'Organization',name:'Mercer Lane Press',url:'https://mercerlanepress.com/'},mainEntityOfPage:url};
---
<BaseLayout title={title} description={description} type="article" schema={schema}><Breadcrumbs items={[{name:'Home',href:'/'},{name:'5G Home Internet',href:'/5g-home-internet/'},{name:title}]} /><article class="article wrap narrow"><header><p class="eyebrow">PRACTICAL GUIDE</p><h1>{title}</h1><p class="lede">{description}</p><p class="byline">By <a href="/authors/mercer-lane/">Mercer Lane</a> · Published <time datetime={published.toISOString()}>{published.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></p></header><div class="article-body"><slot /></div><aside class="book-note"><p class="eyebrow">GO DEEPER</p><h2>A complete diagnostic system</h2><p><em>The 5G Home Internet Troubleshooting Manual</em> expands these steps into a five-layer process, with logs, symptom matrices, placement scoring, and worked scenarios.</p><a class="button" href="/books/the-5g-home-internet-troubleshooting-manual/">Explore the book</a></aside><nav class="related" aria-label="Related guides"><h2>Continue troubleshooting</h2><ul>{related.map((slug:string)=><li><a href={`/5g-home-internet/${slug}/`}>{slug.replaceAll('-',' ')}</a></li>)}</ul></nav></article></BaseLayout>
