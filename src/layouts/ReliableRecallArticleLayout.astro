---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const { entry } = Astro.props;
const { title, description, published, related } = entry.data;
const url = new URL('/reliable-recall/' + entry.id + '/', Astro.site).href;
const schema = {
  '@context':'https://schema.org',
  '@type':'Article',
  headline:title,
  description,
  datePublished:published.toISOString().slice(0,10),
  author:{'@type':'Person',name:'Sophie Ardenwood',url:'https://mercerlanepress.com/authors/sophie-ardenwood/'},
  publisher:{'@type':'Organization',name:'Mercer Lane Press',url:'https://mercerlanepress.com/'},
  mainEntityOfPage:url
};
---
<BaseLayout title={title} description={description} type="article" schema={schema}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Dog Guides',href:'/dog-guides/'},{name:'Reliable Recall',href:'/reliable-recall/'},{name:title}]}/>
  <article class="article wrap narrow">
    <header>
      <p class="eyebrow">RELIABLE RECALL GUIDE</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="byline">By <a href="/authors/sophie-ardenwood/">Sophie Ardenwood</a> · Published <time datetime={published.toISOString()}>{published.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></p>
    </header>
    <div class="article-body"><slot /></div>
    <aside class="book-note">
      <p class="eyebrow">BUILD THE FULL RECALL SYSTEM</p>
      <h2>Move from easy returns to evidence-based real-world proofing</h2>
      <p><em>Reliable Recall: From Long Line to Real-World Freedom</em> brings together cue protection, long-line handling, distance and distraction proofing, reward-and-release, environment-specific readiness checks, a 30-day plan, troubleshooting tools, and safety boundaries.</p>
      <a class="button" href="/books/reliable-recall/">Explore the book</a>
    </aside>
    <nav class="related" aria-label="Related reliable recall guides"><h2>Related reliable recall guides</h2><ul>{related.map((slug:string) => <li><a href={'/reliable-recall/' + slug + '/'}>{slug.replaceAll('-',' ')}</a></li>)}</ul></nav>
  </article>
</BaseLayout>
