---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { books } from '../../data/books';

const dogBooks = books.filter(book => book.authorSlug === 'sophie-ardenwood');
const schema = {
  '@context':'https://schema.org',
  '@type':'CollectionPage',
  name:'Dog Guides',
  description:'Practical dog guides from Mercer Lane Press covering real-world recall, long-line proofing, over-arousal and settling, rescue-dog first months, reactive walking, enrichment, cooperative care, handling, and everyday routines.',
  url:'https://mercerlanepress.com/dog-guides/',
  hasPart:[
    {'@type':'WebPage',name:'Reliable Recall',url:'https://mercerlanepress.com/reliable-recall/'},
    {'@type':'WebPage',name:'Rescue Dog First 90 Days',url:'https://mercerlanepress.com/rescue-dog-first-90-days/'},
    {'@type':'WebPage',name:'Over-Aroused Dog',url:'https://mercerlanepress.com/over-aroused-dog/'},
    {'@type':'WebPage',name:'Reactive Dog Walking',url:'https://mercerlanepress.com/reactive-dog-walking/'},
    {'@type':'WebPage',name:'Dog Enrichment',url:'https://mercerlanepress.com/dog-enrichment/'},
    {'@type':'WebPage',name:'Cooperative Care for Dogs',url:'https://mercerlanepress.com/cooperative-care/'}
  ]
};
---
<BaseLayout title="Dog Guides | Rescue Dogs, Walking, Enrichment & Cooperative Care" description="Practical dog guides from Mercer Lane Press covering over-arousal and settling, rescue-dog first months, reactive walking, enrichment, cooperative care, handling, and everyday routines." schema={schema}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Guides',href:'/guides/'},{name:'Dog Guides'}]}/>
  <header class="page-head wrap">
    <p class="eyebrow">DOG GUIDES</p>
    <h1>Practical Dog Guides</h1>
    <p class="lede">Start with the problem in front of you: building real-world recall, helping an excitable dog come back down, settling a newly adopted dog, making walks more manageable, adding useful enrichment, or making routine handling and care easier to train.</p>
  </header>

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head"><h2>Choose the area that best matches the problem</h2><p>Each topic has its own focused hub, step-by-step articles, and links to the relevant Mercer Lane Press books.</p></div>
      <div class="grid-3">
        <article class="card"><p class="eyebrow">DOG RECALL & OUTDOOR PROOFING</p><h2><a href="/reliable-recall/">Reliable Recall</a></h2><p>Long-line handling, cue protection, distance and distraction proofing, scent and wildlife, social distractions, and environment-specific off-leash readiness.</p><a class="text-link" href="/reliable-recall/">Browse reliable recall guides →</a></article>
        <article class="card"><p class="eyebrow">DOG SETTLING & OVER-AROUSAL</p><h2><a href="/over-aroused-dog/">The Over-Aroused Dog</a></h2><p>Escalation signs, recovery time, trigger stacking, daily rhythm, settle skills, and a four-week plan for dogs that struggle to switch off.</p><a class="text-link" href="/over-aroused-dog/">Browse over-arousal guides →</a></article>
        <article class="card"><p class="eyebrow">RESCUE DOG SETTLING</p><h2><a href="/rescue-dog-first-90-days/">Rescue Dog First 90 Days</a></h2><p>First-day setup, predictable routines, stress and recovery signs, resident-dog introductions, alone-time foundations, and knowing when to slow down or get help.</p><a class="text-link" href="/rescue-dog-first-90-days/">Browse rescue dog guides →</a></article>
        <article class="card"><p class="eyebrow">DOG WALKING</p><h2><a href="/reactive-dog-walking/">Reactive Dog Walking</a></h2><p>Working distance, early warning signs, clean exits, route planning, recovery, and practical reward-based walking skills.</p><a class="text-link" href="/reactive-dog-walking/">Browse reactive dog walking guides →</a></article>
        <article class="card"><p class="eyebrow">DOG ENRICHMENT</p><h2><a href="/dog-enrichment/">Dog Enrichment</a></h2><p>Short sniffing, searching, thinking, play, no-food, indoor, and small-space activities with simple safety and difficulty checks.</p><a class="text-link" href="/dog-enrichment/">Browse dog enrichment guides →</a></article>
        <article class="card"><p class="eyebrow">DOG HANDLING & CARE</p><h2><a href="/cooperative-care/">Cooperative Care for Dogs</a></h2><p>Stress signals, start buttons, micro-steps, nail and grooming preparation, veterinary handling, and knowing when training is no longer the right next step.</p><a class="text-link" href="/cooperative-care/">Browse cooperative care guides →</a></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">BOOKS BY SOPHIE ARDENWOOD</p><h2>Longer systems for repeat-use problems</h2><p>The dog guides connect to the relevant books so readers can move from one immediate question to a fuller operating system when they need it.</p></div>
      <div class="grid-3">
        {dogBooks.map(book => <article class="card"><h3><a href={'/books/' + book.slug + '/'}>{book.title}</a></h3><p>{book.description}</p><a class="text-link" href={'/books/' + book.slug + '/'}>Explore the book →</a></article>)}
      </div>
      <div class="actions"><a class="button button-secondary" href="/authors/sophie-ardenwood/">About Sophie Ardenwood</a></div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap prose">
      <h2>Use the guides as education, not a substitute for individual care</h2>
      <p>The dog material on Mercer Lane Press is general educational information. Pain, illness, sudden behavior change, severe fear, persistent panic, biting, serious aggression, or an immediate safety problem can require veterinary and appropriately qualified behavior support.</p>
    </div>
  </section>
</BaseLayout>
