---
import { getCollection, render } from 'astro:content';
import ConstructionEstimatingArticleLayout from '../../layouts/ConstructionEstimatingArticleLayout.astro';

export async function getStaticPaths(){
  return (await getCollection('constructionEstimatingGuides')).map(entry => ({params:{slug:entry.id},props:{entry}}));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<ConstructionEstimatingArticleLayout entry={entry}><Content /></ConstructionEstimatingArticleLayout>
