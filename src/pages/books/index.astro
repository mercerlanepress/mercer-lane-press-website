---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import BookCover from '../../components/BookCover.astro'; import {books} from '../../data/books';
---
<BaseLayout title="Books" description="Browse practical problem-solving nonfiction published by Mercer Lane Press."><Breadcrumbs items={[{name:'Home',href:'/'},{name:'Books'}]}/><header class="page-head wrap"><p class="eyebrow">OUR CATALOG</p><h1>Books</h1><p class="lede">Focused nonfiction for readers who want a reliable way to diagnose a problem and decide what to do next.</p></header><section class="section section-tint"><div class="wrap">{books.map(book=><article class="book-layout"><BookCover book={book}/><div><p class="eyebrow">PRACTICAL GUIDE</p><h2>{book.title}</h2><p><strong>{book.subtitle}</strong></p><p>By <a href={`/authors/${book.authorSlug}/`}>{book.author}</a></p><p>{book.description}</p><a class="button" href={`/books/${book.slug}/`}>View book details</a></div></article>)}</div></section></BaseLayout>
