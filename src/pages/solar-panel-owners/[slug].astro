---
import { getCollection, render } from 'astro:content';
import SolarPanelOwnerArticleLayout from '../../layouts/SolarPanelOwnerArticleLayout.astro';

export async function getStaticPaths() {
  return (await getCollection('solarPanelOwnerGuides')).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<SolarPanelOwnerArticleLayout entry={entry}><Content /></SolarPanelOwnerArticleLayout>
