---
import { getCollection, render } from 'astro:content';
import HeatPumpOwnerArticleLayout from '../../layouts/HeatPumpOwnerArticleLayout.astro';

export async function getStaticPaths(){
  return (await getCollection('heatPumpOwnerGuides')).map(entry => ({params:{slug:entry.id},props:{entry}}));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<HeatPumpOwnerArticleLayout entry={entry}><Content /></HeatPumpOwnerArticleLayout>