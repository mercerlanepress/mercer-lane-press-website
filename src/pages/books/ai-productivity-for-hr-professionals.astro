---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BookCover from '../../components/BookCover.astro';
import GuideCard from '../../components/GuideCard.astro';
import { books } from '../../data/books';
const book=books.find(({slug})=>slug==='ai-productivity-for-hr-professionals')!;
const guides=(await getCollection('hrAiGuides')).sort((a,b)=>a.data.order-b.data.order);
const categories=[
['Recruitment & talent acquisition','Job descriptions, job postings, sourcing strings, screening questions, behavioral interviews, scorecards, candidate communication, offers, panel briefing, comparisons, sourcing strategy, and reference checks.'],
['Onboarding & employee experience','30-60-90 plans, pre-boarding messages, manager preparation, buddy programs, early feedback, exit interviews, engagement surveys, recognition, return-to-work planning, and remote-hire setup.'],
['Performance management','Performance-review drafts, self-assessments, SMART goals, PIP structures, coaching talking points, 360 summaries, promotion cases, difficult feedback, role-play, recognition, and check-ins.'],
['Employee communication','Policy announcements, workplace changes, deadline reminders, restructuring talking points, FAQs, team updates, sensitive messages, values communication, survey results, and tone improvement.'],
['Policy, compliance & documentation','Policy and handbook drafts, SOPs, document summaries, incident records, investigation questions, change logs, accommodation-process drafts, and data-retention summaries—with human and legal review where appropriate.'],
['HR reports & people analytics','Headcount, attrition, recruiting funnels, representation metrics, compensation benchmarking, absence patterns, dashboards, engagement data, training results, leadership summaries, span of control, and internal mobility.'],
['Learning & development','Training outlines, manager micro-lessons, learning paths, skills gaps, mentorship, new-manager curricula, feedback surveys, internal mobility, learning summaries, training nudges, coaching skills, and program pitches.'],
['Employee relations & conflict resolution','Mediation preparation, complaint summaries, diagnostic questions, de-escalation language, trust rebuilding, bias checks, difficult-conversation role-play, grievance drafts, workshops, and manager talking points.']
];
const schema={'@context':'https://schema.org','@type':'Book',name:book.title,alternativeHeadline:book.subtitle,author:{'@type':'Person',name:book.author,url:'https://mercerlanepress.com/authors/mercer-lane/'},publisher:{'@type':'Organization',name:book.publisher,url:'https://mercerlanepress.com/'},description:book.description,url:new URL('/books/'+book.slug+'/',Astro.site).href,sameAs:book.purchaseUrl};
---
<BaseLayout title={book.title} description={book.description} image={book.coverReady?book.cover:undefined} schema={schema}>
<Breadcrumbs items={[{name:'Home',href:'/'},{name:'Books',href:'/books/'},{name:book.title}]}/>
<section class="wrap book-layout"><BookCover book={book} large/><div><p class="eyebrow">AI FOR HR PROFESSIONALS</p><h1>{book.title}</h1><p class="lede">{book.subtitle}</p><p>By <a href="/authors/mercer-lane/">Mercer Lane</a> · Published by Mercer Lane Press</p><p>{book.description}</p><div class="actions"><a class="button" href={book.purchaseUrl}>Buy on Amazon</a><a class="button button-secondary" href="/hr-ai/">Read free HR AI guides</a></div></div></section>
<section class="section section-tint"><div class="wrap"><div class="section-head"><p class="eyebrow">WHO IT IS FOR</p><h2>For HR professionals who want reusable help with high-volume drafting and workflow work</h2><p>{book.intendedReader}</p></div><ul class="check-grid">{book.problems?.map(item=><li>{item}</li>)}</ul></div></section>
<section class="section"><div class="wrap"><div class="section-head"><p class="eyebrow">THE CORE PROMPT FORMULA</p><h2>Role + Task + Context + Output</h2><p>The book teaches one reusable structure for making AI instructions more specific: define the working role, state the exact task, provide the relevant context, and specify the output format. Every generated result remains a draft to review, edit, verify, and—where appropriate—send through legal or compliance review.</p></div><div class="grid-3"><article class="card"><h3>Role</h3><p>Set the relevant working perspective, such as recruiter, HR business partner, HR coordinator, or people analytics specialist.</p></article><article class="card"><h3>Task + Context</h3><p>Name the job clearly and provide only the facts the draft needs, while minimizing confidential or identifiable employee information.</p></article><article class="card"><h3>Output + Review</h3><p>Specify the usable format, then check facts, tone, policy alignment, privacy, and any legal or compliance implications before use.</p></article></div></div></section>
<section class="section section-tint"><div class="wrap"><div class="section-head"><p class="eyebrow">WHAT IT COVERS</p><h2>Eight core HR prompt categories</h2></div><div class="grid-3">{categories.map(([title,text])=><article class="card"><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
<section class="section"><div class="wrap"><div class="section-head"><p class="eyebrow">WORKFLOWS & ACTION PLANS</p><h2>Move from isolated prompts to repeatable HR processes</h2><p>The book connects prompts into five workflows: requisition-to-offer hiring, new-hire onboarding, the performance-review cycle, employee query and case resolution, and compliance/documentation. Five mini action plans cover a 7-day AI adoption sprint, weekly recruitment, monthly reporting, difficult-conversation preparation, and quarterly compliance documentation.</p></div><ul class="check-grid">{book.outcomes?.map(item=><li>{item}</li>)}</ul></div></section>
<section class="section section-tint"><div class="wrap"><div class="section-head"><p class="eyebrow">FREE SUPPORTING GUIDES</p><h2>Put the principles into practice</h2></div><div class="grid-3">{guides.map(guide=><GuideCard guide={guide} base="/hr-ai/" label="HR AI" />)}</div></div></section>
<section class="section"><div class="wrap narrow"><div class="notice"><strong>Important boundary.</strong> The book provides general guidance on AI-assisted HR work. It is not legal, compliance, or employment-law advice. Employment law varies by jurisdiction and industry. AI-generated policies, contracts, disciplinary communications, compliance documents, and other consequential material should receive the qualified review appropriate to the situation. Follow your organization's privacy, confidentiality, and information-security requirements, and do not place identifiable employee data or confidential records into public AI tools without approval.</div><p><a class="button" href={book.purchaseUrl}>View on Amazon</a></p></div></section>
</BaseLayout>