---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const { entry } = Astro.props;
const { title, description, published, related } = entry.data;
const url = new URL('/reactive-dog-walking/' + entry.id + '/', Astro.site).href;
const schema = {
  '@context':'https://schema.org',
  '@type':'Article',
  headline:title,
  description,
  datePublished:published.toISOString().slice(0,10),
  author:{'@type':'Person',name:'Sophie Ardenwood',url:'https://mercerlanepress.com/authors/sophie-ardenwood/'},
  publisher:{'@type':'Organization',name:'Mercer Lane Press',url:'https://mercerlanepress.com/'},
  mainEntityOfPage:url
};
---
<BaseLayout title={title} description={description} type="article" schema={schema}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Dog Guides',href:'/dog-guides/'},{name:'Reactive Dog Walking',href:'/reactive-dog-walking/'},{name:title}]}/>
  <article class="article wrap narrow">
    <header>
      <p class="eyebrow">REACTIVE DOG WALKING GUIDE</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="byline">By <a href="/authors/sophie-ardenwood/">Sophie Ardenwood</a> · Published <time datetime={published.toISOString()}>{published.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></p>
    </header>
    <div class="article-body"><slot /></div>
    <aside class="book-note">
      <p class="eyebrow">BUILD THE FULL WALKING SYSTEM</p>
      <h2>Turn isolated tips into a repeatable plan</h2>
      <p><em>The Reactive Dog Walking Playbook</em> combines trigger mapping, working distance, rehearsed exits, a 14-day reset, an eight-week progression, scenario labs, and quick-reference walk cards.</p>
      <a class="button" href="/books/the-reactive-dog-walking-playbook/">Explore the book</a>
    </aside>
    <nav class="related" aria-label="Related guides"><h2>Related reactive dog walking guides</h2><ul>{related.map((slug:string) => <li><a href={'/reactive-dog-walking/' + slug + '/'}>{slug.replaceAll('-',' ')}</a></li>)}</ul></nav>
  </article>
</BaseLayout>
