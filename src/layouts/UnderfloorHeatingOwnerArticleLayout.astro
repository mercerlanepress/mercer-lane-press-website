---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const { entry } = Astro.props;
const { title, description, published, related } = entry.data;
const url = new URL('/underfloor-heating-owners/' + entry.id + '/', Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: published.toISOString().slice(0,10),
  author: { '@type': 'Person', name: 'Gareth Fenwick', url: 'https://mercerlanepress.com/authors/gareth-fenwick/' },
  publisher: { '@type': 'Organization', name: 'Mercer Lane Press', url: 'https://mercerlanepress.com/' },
  mainEntityOfPage: url
};
---
<BaseLayout title={title} description={description} type="article" schema={schema}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Guides',href:'/guides/'},{name:'Underfloor Heating',href:'/underfloor-heating-owners/'},{name:title}]}/>
  <article class="article wrap narrow">
    <header>
      <p class="eyebrow">UK UNDERFLOOR HEATING OWNER GUIDE</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="byline">By <a href="/authors/gareth-fenwick/">Gareth Fenwick</a> · Published <time datetime={published.toISOString()}>{published.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time></p>
    </header>
    <div class="article-body"><slot /></div>
    <aside class="book-note">
      <p class="eyebrow">THE COMPLETE HOMEOWNER GUIDE</p>
      <h2>Understand your system and keep useful records</h2>
      <p><em>Living With Underfloor Heating</em> brings together wet and electric heating controls, zones, comfort, scheduling, bills and troubleshooting, with a system passport and printable records for professional handover.</p>
      <a class="button" href="/books/living-with-underfloor-heating/">Explore the book</a>
    </aside>
    <nav class="related" aria-label="Related underfloor heating guides">
      <h2>Related underfloor heating guides</h2>
      <ul>{related.map((slug:string) => <li><a href={'/underfloor-heating-owners/' + slug + '/'}>{slug.replaceAll('-',' ')}</a></li>)}</ul>
    </nav>
    <p class="notice"><strong>Important safety boundary.</strong> Observe only accessible displays, documents and ordinary controls allowed by the exact manufacturer's instructions. Do not alter manifold balancing, mixing valves, flow meters, protected heat-source settings or electrical wiring. Seek urgent help for leaks near electrics, gas/CO concerns, dangerous overheating or other immediate hazards.</p>
  </article>
</BaseLayout>
