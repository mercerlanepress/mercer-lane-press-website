---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const { entry } = Astro.props;
const { title, description, published, related } = entry.data;
const url = new URL('/rescue-dog-first-90-days/' + entry.id + '/', Astro.site).href;
const schema = {
  '@context':'https://schema.org',
  '@type':'Article',
  headline:title,
  description,
  datePublished:published.toISOString().slice(0,10),
  author:{'@type':'Person',name:'Sophie Ardenwood',url:'https://mercerlanepress.com/authors/sophie-ardenwood/'},
  publisher:{'@type':'Organization',name:'Mercer Lane Press',url:'https://mercerlanepress.com/'},
  mainEntityOfPage:url
};
---
<BaseLayout title={title} description={description} type="article" schema={schema}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Rescue Dog First 90 Days',href:'/rescue-dog-first-90-days/'},{name:title}]}/>
  <article class="article wrap narrow">
    <header>
      <p class="eyebrow">RESCUE DOG FIRST 90 DAYS GUIDE</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="byline">By <a href="/authors/sophie-ardenwood/">Sophie Ardenwood</a> · Published <time datetime={published.toISOString()}>{published.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></p>
    </header>
    <div class="article-body"><slot /></div>
    <aside class="book-note">
      <p class="eyebrow">BUILD THE FULL 90-DAY SYSTEM</p>
      <h2>Turn early rescue-dog decisions into a repeatable plan</h2>
      <p><em>The Rescue Dog First 90 Days</em> brings together first-day setup, predictable routines, body-language and recovery tracking, reward-based skills, introductions, alone time, handling, veterinary preparation, setbacks, and a 13-week operating plan.</p>
      <a class="button" href="/books/the-rescue-dog-first-90-days/">Explore the book</a>
    </aside>
    <nav class="related" aria-label="Related rescue dog guides"><h2>Related rescue dog first 90 days guides</h2><ul>{related.map((slug:string) => <li><a href={'/rescue-dog-first-90-days/' + slug + '/'}>{slug.replaceAll('-',' ')}</a></li>)}</ul></nav>
  </article>
</BaseLayout>
