---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const { entry } = Astro.props;
const { title, description, published, related } = entry.data;
const url = new URL('/local-business-ai/' + entry.id + '/', Astro.site).href;
const schema = {'@context':'https://schema.org','@type':'Article',headline:title,description,datePublished:published.toISOString().slice(0,10),author:{'@type':'Person',name:'Mercer Lane',url:'https://mercerlanepress.com/authors/mercer-lane/'},publisher:{'@type':'Organization',name:'Mercer Lane Press',url:'https://mercerlanepress.com/'},mainEntityOfPage:url};
---
<BaseLayout title={title} description={description} type="article" schema={schema}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Guides',href:'/guides/'},{name:'Local Business AI',href:'/local-business-ai/'},{name:title}]}/>
  <article class="article wrap narrow">
    <header><p class="eyebrow">LOCAL BUSINESS AI GUIDE</p><h1>{title}</h1><p class="lede">{description}</p><p class="byline">By <a href="/authors/mercer-lane/">Mercer Lane</a> · Published <time datetime={published.toISOString()}>{published.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></p></header>
    <div class="article-body"><slot /></div>
    <aside class="book-note"><p class="eyebrow">GO DEEPER</p><h2>A 30-day owner system</h2><p><em>Get Your Local Business Recommended by AI</em> expands these ideas into a structured operating system for identity, relevance, proof, corroboration, access, testing, and maintenance.</p><a class="button" href="/books/get-your-local-business-recommended-by-ai/">Explore the book</a></aside>
    <nav class="related" aria-label="Related guides"><h2>Related guides</h2><ul>{related.map((slug:string)=><li><a href={'/local-business-ai/' + slug + '/'}>{slug.replaceAll('-',' ')}</a></li>)}</ul></nav>
  </article>
</BaseLayout>
