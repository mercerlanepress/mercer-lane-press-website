---
const { book, large = false } = Astro.props;
---
<div class:list={['cover-shell', large && 'cover-large']}>
  <div class="cover-placeholder" role="img" aria-label={`Placeholder cover for ${book.title}`}>
    <small>MERCER LANE PRESS</small><h2>{book.title}</h2><p>Provider-neutral troubleshooting</p><strong>{book.author}</strong>
  </div>
  <!-- When the final cover is supplied, replace this placeholder div with: <img src={book.cover} alt={`Cover of ${book.title} by ${book.author}`} /> -->
</div>
