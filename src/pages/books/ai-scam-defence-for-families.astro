---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import BookCover from '../../components/BookCover.astro'; import {books} from '../../data/books';
const book=books.find(({slug})=>slug==='ai-scam-defence-for-families')!;
const schema={'@context':'https://schema.org','@type':'Book',name:book.title,author:{'@type':'Person',name:book.author,url:'https://mercerlanepress.com/authors/rebecca-tolland/'},publisher:{'@type':'Organization',name:book.publisher,url:'https://mercerlanepress.com/'},description:book.description,image:new URL(book.cover,Astro.site).href,url:new URL('/books/'+book.slug+'/',Astro.site).href,offers:{'@type':'Offer',url:book.purchaseUrl,availability:'https://schema.org/InStock'}};
---
<BaseLayout title={book.title} description={book.description} image={book.cover} schema={schema}><Breadcrumbs items={[{name:'Home',href:'/'},{name:'Books',href:'/books/'},{name:book.title}]}/><section class="wrap book-layout"><BookCover book={book} large/><div><p class="eyebrow">FAMILY SAFETY GUIDE</p><h1>{book.title}</h1><p class="lede">{book.subtitle}</p><p>By <a href="/authors/rebecca-tolland/">Rebecca Tolland</a> · Published by Mercer Lane Press</p><p>{book.description}</p><div class="actions"><a class="button" href={book.purchaseUrl}>Buy on Amazon</a><a class="button button-secondary" href="/ai-scam-defence/">Read free guides</a></div></div></section><section class="section section-tint"><div class="wrap"><div class="section-head"><p class="eyebrow">WHO IT IS FOR</p><h2>A shared plan for suspicious requests</h2><p>{book.intendedReader}</p></div><ul class="check-grid">{book.problems?.map(item=><li>{item}</li>)}</ul></div></section><section class="section"><div class="wrap"><div class="section-head"><p class="eyebrow">PRACTICAL DEFENCES</p><h2>What readers can put into practice</h2></div><div class="grid-3">{book.topics?.map(topic=><article class="card"><h3>{topic}</h3><p>Replace pressure and assumptions with a clear, repeatable next step.</p></article>)}</div><div class="notice"><strong>If money or an account may already be at risk:</strong> contact the relevant bank, payment service, or account provider through its official channel immediately. For threats or immediate danger, contact local emergency services.</div></div></section><section class="section section-tint"><div class="wrap prose"><h2>Start with preparation, not panic</h2><p>AI can make an impersonation more convincing, but the safest response does not depend on perfectly detecting generated media. A pause, a separate trusted contact route, and firm family rules for payments and security codes can interrupt the scammer's script.</p><p>Use the <a href="/ai-scam-defence/">free AI scam defence guides</a> to begin building that routine.</p></div></section></BaseLayout>
