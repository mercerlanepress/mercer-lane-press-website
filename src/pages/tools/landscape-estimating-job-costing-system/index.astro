---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { landscapeSystem as product } from '../../../data/landscape-system';
const workflow = [
 ['Estimate the work','Define scope, convert quantities, estimate productive and paid labour, and include the complete direct cost base.'],
 ['Review and quote','Apply one overhead method and markup or margin. Resolve readiness checks, review the bid and export the customer quote.'],
 ['Freeze and track','Copy the awarded handoff as values to preserve the sold budget. Record incurred costs and approved variations by Job ID.'],
 ['Close and learn','Confirm final costs, revenue and overhead. Compare estimate versus actual, then review comparable production evidence.'],
];
const previews = [
 ['03_estimating','Actual Estimate Review from the fictional USD demo, with direct costs, overhead, quoted price and margins','Build and review the cost base before pricing.'],
 ['04_client_quote','Actual customer-facing landscape quotation, including scope, exclusions, a priced option and total','Export Client Quote only; internal costs and profit stay private.'],
 ['05_actual_job_profit','Actual Job Review comparing revised category budgets with fictional incurred costs and final job profit','See cost variances, gross profit and profit after overhead.'],
 ['06_dashboard','Genuine fictional Demo dashboard excerpt with quoted value, win rate, open jobs and final after-overhead profit','Final financial results include only fully closed jobs.'],
];
const faqs = [
 ['Is this only a landscaping estimate template?','It connects estimating and customer quotation with a frozen awarded budget, actual costs, approved changes, final profit and production learning. It is a working Excel system with manual entry and review steps.'],
 ['Can I use my own costs and currency?','Yes. Replace library inputs with your own current supplier, labour, equipment and production evidence. Use one currency per file. Changing the currency label does not convert amounts.'],
 ['How many estimates and jobs can I keep?','Prepared capacity is 50 estimates and 50 jobs, 300 transaction rows per table and 100 library rows. Archive a complete dated file and start a fresh working file from the clean original when needed. Adding an Excel table row alone does not extend the prepared calculations.'],
 ['Does it create invoices or track payments?','No. Client Quote is a quotation/proposal. The system records incurred job costs and management profit; use your existing invoicing, payroll and accounting processes.'],
 ['Why is final profit blank on an open job?','Open jobs show costs to date. Final profit requires completed status, confirmed final costs and revenue, explicit reviewed base revenue and overhead, clean cost logs, and all variations resolved as Approved or Rejected.'],
 ['Will it work in Google Sheets or Excel for Mac?','Windows Excel desktop 16.0 is the tested environment. Mac Excel, older Excel, Excel Web, Google Sheets and other spreadsheet apps have not been individually certified. Validation, protection and printing can vary. Use Excel desktop.'],
 ['Is there a subscription?','There is no product subscription. This is a one-time digital purchase; Microsoft Excel is required and supplied separately. The core workbook needs no macros, add-ins, external workbook links or internet connection.'],
 ['How do I receive the files and get help?','Buy through Etsy and download one ZIP containing the six customer files. Extract it on your computer and read the Quick Start Guide. For product help, contact MercerLanePress through your Etsy order with the version and a non-sensitive description.'],
];
const schema = [
 {'@context':'https://schema.org','@type':'Product',name:product.name,sku:'MLP-LANDSCAPE-1-1',description:'A 27-sheet Excel landscape estimating and job-costing system with clean and Demo workbooks, three PDF guides and use notes.',brand:{'@type':'Brand',name:'Mercer Lane Press'},image:new URL(product.image,Astro.site).href,url:new URL(product.pagePath,Astro.site).href,offers:{'@type':'Offer',url:product.checkoutUrl,price:product.price,priceCurrency:product.currency,seller:{'@type':'Organization',name:'Mercer Lane Press'}}},
 {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([question,answer])=>({'@type':'Question',name:question,acceptedAnswer:{'@type':'Answer',text:answer}}))},
];
---
<BaseLayout title="Landscape Estimating & Job Costing Excel Spreadsheet | Mercer Lane Press" description="Estimate landscape jobs, create client quotes, track actual costs and review final profit. Clean and Demo Excel workbooks plus three PDF guides. Buy on Etsy." image={product.image} schema={schema}>
 <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Tools',href:'/tools/'},{name:'Landscape Estimating & Job Costing System'}]}/>
 <header class="wrap page-head landscape-hero">
  <div><p class="eyebrow">MERCER LANE PRESS · EXCEL SYSTEM · v{product.version}</p><h1>Landscape Contractor Estimating &amp; Job Costing System</h1>
   <p class="lede">Estimate the job, create the quote, track the actual costs and see what the job really made.</p>
   <p>A connected landscaping estimate spreadsheet for contractors, owner-operators and small garden construction teams.</p>
   <div class="purchase-row"><p class="price">{product.priceLabel} <span>Introductory price · one-time digital purchase</span></p><a class="button" href={product.checkoutUrl} rel="noopener">Buy the system on Etsy</a></div>
   <p><a class="text-link" href="#inside">See inside the workbook ↓</a></p>
   <p class="small">Microsoft Excel desktop required and supplied separately. Etsy handles checkout and download delivery, including applicable taxes and local-currency conversion. Digital download; no physical item.</p>
  </div>
  <figure><img src={product.image} alt="Landscape estimating and job costing Excel system with actual fictional Demo customer quote and job results" width="1600" height="1200" fetchpriority="high"/><figcaption>27 sheets. Clean and Demo workbooks. Three PDF guides and a README.</figcaption></figure>
 </header>
 <section class="section section-tint"><div class="wrap narrow"><h2>Make the cost base visible before you quote</h2><p>Labour, purchase quantities, equipment, delivery and disposal can disappear inside a price guessed from experience. Build them deliberately, recover overhead once and keep markup distinct from margin. Then preserve the awarded estimate so the final review tells you where the job differed.</p><p>The arithmetic uses your own inputs. The system does not supply universal landscape rates or guarantee that a bid or job will be profitable.</p></div></section>
 <section class="section"><div class="wrap"><h2>From estimate to actual profit</h2><div class="grid-2">{workflow.map(([heading,body])=><article class="card"><h3>{heading}</h3><p>{body}</p></article>)}</div><p>Scope → Quantity takeoff → Materials → Labour → Equipment → Other costs → Overhead → Markup or margin → Bid review → Client quote → Won job → Actual costs → Variations → Actual profit → Production learning.</p></div></section>
 <section class="section section-tint"><div class="wrap"><h2>Built for landscape contractors</h2><div class="grid-3">
  <article class="card"><h3>Materials and waste</h3><p>Separate measured and supplier purchase units. Apply coverage, waste, minimum orders and rounding increments, then include landed material cost.</p><a href="/landscape-contractor-estimating/landscape-material-purchase-quantity/">Read the material quantities and waste guide</a></article>
  <article class="card"><h3>Crew labour and equipment</h3><p>Use direct hours or your company production rates. Keep productive and paid person-hours distinct. Cost owned equipment or rentals with minimum hire, delivery, collection and other fees.</p><a href="/landscape-contractor-estimating/estimate-landscape-labor-hours/">Understand landscape labour-hours</a></article>
  <article class="card"><h3>Overhead and pricing</h3><p>Include subcontractors, disposal, other direct costs and deliberate risk allowances. Choose one of five overhead methods and apply markup or target margin to the defined cost base.</p><a href="/landscape-contractor-estimating/landscape-markup-vs-margin/">Understand markup versus margin</a></article>
 </div></div></section>
 <section class="section" id="inside"><div class="wrap"><h2>See the actual workbook</h2><p>Real product views from the supplied fictional Demo. Prices, rates, customers and outcomes are teaching examples in USD, not benchmarks or recommended prices.</p><div class="preview-grid">{previews.map(([file,alt,caption])=><figure><a href={'/images/landscape-system/'+file+'.webp'}><img src={'/images/landscape-system/'+file+'.webp'} alt={alt} width="1600" height="1200" loading="lazy"/></a><figcaption>{caption}</figcaption></figure>)}</div></div></section>
 <section class="section section-tint"><div class="wrap narrow"><h2>Professional client quotes</h2><p>Client Quote presents your business, customer, project, public scope, exclusions, assumptions, separately priced options, validity, base price and optional single-rate sales tax. Up to 16 public scope statements fit the prepared two-page output.</p><p>Resolve the readiness checks and bid review, then export only Client Quote as PDF. Internal costs, overhead, profit and risk notes stay out of that output. Review both printed pages before issuing each quotation; keep the whole workbook private.</p><h2>Estimate versus actual: keep the learning loop intact</h2><p>The awarded handoff is copied manually as values into the job register to freeze its baseline. Record incurred actual costs and approved variations once. Job Review compares revised budgets with actual materials, paid labour, equipment and other costs.</p><p>Final gross profit and profit after overhead appear only after genuine final closeout. Open-job costs are spending to date, not a forecast to finish. Log comparable completed production observations and review weighted actual rates before deliberately changing expected company rates.</p><a class="text-link" href="/landscape-contractor-estimating/landscape-estimate-versus-actual/">Read the landscape estimate-versus-actual guide →</a></div></section>
 <section class="section"><div class="wrap narrow"><h2>What's included</h2><p>One ZIP containing exactly six customer files:</p><ul><li><strong>Clean Excel system:</strong> 27 sheets, prepared for your own business records.</li><li><strong>Populated Demo workbook:</strong> fictional estimates, quotes, jobs and learning examples.</li><li><strong>Quick Start Guide PDF:</strong> 3 pages, from first estimate to tracking and learning.</li><li><strong>Full User Guide PDF:</strong> 23 pages of methods, reference and troubleshooting.</li><li><strong>FAQ PDF:</strong> 5 pages covering common questions.</li><li><strong>README:</strong> setup, capacity and safe-use notes.</li></ul><h3>Start with a business working copy</h3><ol><li>Purchase on Etsy, download the ZIP and extract all six files.</li><li>Read the Quick Start and explore the Demo separately.</li><li>Save a working copy of the clean workbook; enter your company details and current costs.</li><li>Follow Start Here from scope through pricing, review, quotation and job closeout.</li></ol></div></section>
 <section class="section section-tint"><div class="wrap narrow"><h2>What you need</h2><p>Microsoft Excel desktop. Windows Excel desktop 16.0 is the tested environment; Mac, older Excel, Excel Web, Google Sheets and other apps are not individually certified. Use one responsible editor at a time and one currency per file.</p><p>Prepared capacity: 50 estimates and 50 jobs; 300 transaction rows per table; 100 library rows. Use prepared rows, keep dated backups and archive complete files. Adding a table row alone does not extend calculation ranges.</p><p>Amber cells accept inputs; grey calculations are protected. Unprotect without a password only for deliberate maintenance, then re-protect and check. Protection helps prevent accidental edits and is not encryption.</p><p>Enter your own current costs, production evidence, overhead assumptions, contract wording and local tax treatment. This is a management estimating tool, not an accounting, invoicing, payroll, design or tax-return application. It has no automatic supplier pricing, cloud collaboration or accounting integrations. Developed with AI assistance and reviewed by Mercer Lane Press.</p></div></section>
 <section class="section"><div class="wrap narrow"><h2>Prefer the full estimating method and worked examples?</h2><p><a href="/books/landscape-contractor-estimating-and-pricing/">Landscape Contractor Estimating &amp; Pricing</a> by Warren Holtby explains the six-pass method and sixteen complete worked estimates. The digital system gives you the working Excel files to put the process into practice.</p><p><strong>The book is sold separately and is not included in this download.</strong></p><a class="button button-secondary" href="/books/landscape-contractor-estimating-and-pricing/">Explore the companion book</a><p><a href="/landscape-contractor-estimating/">Browse the free landscape estimating guides</a></p></div></section>
 <section class="section section-tint"><div class="wrap narrow"><h2>Frequently asked questions</h2>{faqs.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}<h2>Get the Landscape Estimating System</h2><p>Keep estimate, quote, actual costs and final profit in one working process.</p><a class="button" href={product.checkoutUrl} rel="noopener">Get the digital system on Etsy — {product.priceLabel}</a><p class="small">One-time digital purchase. Excel supplied separately. Etsy displays applicable tax and any currency conversion.</p></div></section>
</BaseLayout>
<style>
.purchase-row{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem 1.5rem;margin:1rem 0}.purchase-row .price{margin:0;font-size:1.8rem}.purchase-row .price span{max-width:210px;font-size:.9rem}
.grid-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}.landscape-hero{display:grid;grid-template-columns:1.15fr 1fr;gap:2rem;align-items:center}.landscape-hero figure{margin:0}.landscape-hero img,.preview-grid img{display:block;width:100%;height:auto;border:1px solid var(--line)}.preview-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}.preview-grid figure{margin:0}figcaption{font-size:.9rem;color:var(--muted);margin-top:.7rem}.page-head{padding-top:2rem}.landscape-hero .actions{margin-top:1rem}.page-head h1{font-size:clamp(2.3rem,4vw,3rem);max-width:900px}.price{font-size:2rem;font-weight:700}.price span{display:block;font-size:1rem;font-weight:400}.small{font-size:.9rem;color:var(--muted);margin-top:1rem}details{border-bottom:1px solid var(--line);padding:1rem 0}summary{font-weight:700;cursor:pointer}details p{margin-top:.8rem}h2{scroll-margin-top:5rem}@media(max-width:800px){.landscape-hero,.preview-grid,.grid-2{grid-template-columns:1fr}}
</style>
