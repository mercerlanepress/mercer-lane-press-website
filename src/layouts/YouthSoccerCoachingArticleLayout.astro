---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const { entry } = Astro.props;
const { title, description, published, related } = entry.data;
const url = new URL('/youth-soccer-coaching/' + entry.id + '/', Astro.site).href;
const schema = {
  '@context':'https://schema.org',
  '@type':'Article',
  headline:title,
  description,
  datePublished:published.toISOString().slice(0,10),
  author:{'@type':'Organization',name:'Mercer Lane Press',url:'https://mercerlanepress.com/'},
  publisher:{'@type':'Organization',name:'Mercer Lane Press',url:'https://mercerlanepress.com/'},
  mainEntityOfPage:url
};
---
<BaseLayout title={title} description={description} type="article" schema={schema}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Youth Soccer Coaching',href:'/youth-soccer-coaching/'},{name:title}]}/>
  <article class="article wrap narrow">
    <header>
      <p class="eyebrow">VOLUNTEER YOUTH SOCCER COACHING</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="byline">By Mercer Lane Press · Published <time datetime={published.toISOString()}>{published.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></p>
    </header>
    <div class="article-body"><slot /></div>
    <aside class="book-note">
      <p class="eyebrow">THE COMPLETE FIRST-SEASON SYSTEM</p>
      <h2>Turn separate coaching jobs into one weekly loop</h2>
      <p><em>So You've Volunteered to Coach Soccer</em> by Grant Ellwood expands these ideas across team setup, six starter practices, parent communication, match-day planning, playing-time rotations, common disruptions, season review and field-side tools.</p>
      <a class="button" href="/books/so-youve-volunteered-to-coach-soccer/">Explore the book</a>
    </aside>
    <nav class="related" aria-label="Related youth soccer coaching guides"><h2>Related youth soccer coaching guides</h2><ul>{related.map((slug:string) => <li><a href={'/youth-soccer-coaching/' + slug + '/'}>{slug.replaceAll('-',' ')}</a></li>)}</ul></nav>
    <div class="notice"><strong>Use current requirements.</strong> These pages provide general coaching and organizational information. Rules, safeguarding, concussion, weather, participation and reporting requirements vary and can change. Follow the current procedures, training and official rules that apply to your team.</div>
  </article>
</BaseLayout>
