---
import { getCollection, render } from 'astro:content';
import PoolTroubleshootingArticleLayout from '../../layouts/PoolTroubleshootingArticleLayout.astro';

export async function getStaticPaths(){
  return (await getCollection('poolTroubleshootingGuides')).map(entry => ({params:{slug:entry.id},props:{entry}}));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<PoolTroubleshootingArticleLayout entry={entry}><Content /></PoolTroubleshootingArticleLayout>
