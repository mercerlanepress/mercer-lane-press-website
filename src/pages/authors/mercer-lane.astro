---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import {authors} from '../../data/authors'; import {featuredBook} from '../../data/books'; const author=authors[0]; const schema={'@context':'https://schema.org','@type':'Person',name:author.name,url:'https://mercerlanepress.com/authors/mercer-lane/',description:author.bio};
---
<BaseLayout title="Mercer Lane, Author" description="Mercer Lane is the author name used for practical Mercer Lane Press guides where appropriate." schema={schema}><Breadcrumbs items={[{name:'Home',href:'/'},{name:'Authors',href:'/authors/'},{name:author.name}]}/><header class="page-head wrap prose"><p class="eyebrow">AUTHOR</p><h1>{author.name}</h1><p class="lede">{author.bio}</p></header><section class="section section-tint"><div class="wrap prose"><h2>Books by Mercer Lane</h2><h3><a href={`/books/${featuredBook.slug}/`}>{featuredBook.title}</a></h3><p>{featuredBook.description}</p><a class="button" href={`/books/${featuredBook.slug}/`}>Explore the book</a></div></section></BaseLayout>
