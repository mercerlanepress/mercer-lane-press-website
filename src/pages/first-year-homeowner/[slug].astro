---
import { getCollection, render } from 'astro:content';
import FirstYearHomeownerArticleLayout from '../../layouts/FirstYearHomeownerArticleLayout.astro';

export async function getStaticPaths(){
  return (await getCollection('firstYearHomeownerGuides')).map(entry => ({params:{slug:entry.id},props:{entry}}));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<FirstYearHomeownerArticleLayout entry={entry}><Content /></FirstYearHomeownerArticleLayout>
