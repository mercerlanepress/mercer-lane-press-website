---
const path = Astro.url.pathname;
const links = [['/books/','Books'],['/5g-home-internet/','Guides'],['/authors/','Authors'],['/about/','About']];
---
<a class="skip" href="#main-content">Skip to content</a>
<header class="site-header">
  <div class="wrap nav-wrap">
    <a class="brand" href="/" aria-label="Mercer Lane Press home"><span aria-hidden="true">ML</span><strong>Mercer Lane Press</strong></a>
    <nav aria-label="Primary navigation">
      <details>
        <summary>Menu</summary>
        <ul>{links.map(([href,label]) => <li><a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a></li>)}</ul>
      </details>
    </nav>
  </div>
</header>
