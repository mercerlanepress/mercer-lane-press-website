---
import { getCollection, render } from 'astro:content';
import CooperativeCareArticleLayout from '../../layouts/CooperativeCareArticleLayout.astro';

export async function getStaticPaths(){
  return (await getCollection('cooperativeCareGuides')).map(entry => ({params:{slug:entry.id},props:{entry}}));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<CooperativeCareArticleLayout entry={entry}><Content /></CooperativeCareArticleLayout>
