---
import BaseLayout from './BaseLayout.astro'; import Breadcrumbs from '../components/Breadcrumbs.astro';
const { entry } = Astro.props; const { title, description, published, related } = entry.data;
const url = new URL(`/ai-scam-defence/${entry.id}/`, Astro.site).href;
const schema = {'@context':'https://schema.org','@type':'Article',headline:title,description,datePublished:published.toISOString().slice(0,10),author:{'@type':'Person',name:'Rebecca Tolland',url:'https://mercerlanepress.com/authors/rebecca-tolland/'},publisher:{'@type':'Organization',name:'Mercer Lane Press',url:'https://mercerlanepress.com/'},mainEntityOfPage:url};
---
<BaseLayout title={title} description={description} type="article" schema={schema}><Breadcrumbs items={[{name:'Home',href:'/'},{name:'AI Scam Defence',href:'/ai-scam-defence/'},{name:title}]}/><article class="article wrap narrow"><header><p class="eyebrow">FAMILY SAFETY GUIDE</p><h1>{title}</h1><p class="lede">{description}</p><p class="byline">By <a href="/authors/rebecca-tolland/">Rebecca Tolland</a> · Published <time datetime={published.toISOString()}>{published.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></p></header><div class="article-body"><slot /></div><aside class="book-note"><p class="eyebrow">BUILD A FAMILY PLAN</p><h2>Prepare before an urgent message arrives</h2><p><em>AI Scam Defence for Families</em> helps families recognize AI-enabled scams, verify unexpected requests, and decide what to do next.</p><a class="button" href="/books/ai-scam-defence-for-families/">Explore the book</a></aside><nav class="related" aria-label="Related guides"><h2>Related family safety guides</h2><ul>{related.map((slug:string)=><li><a href={`/ai-scam-defence/${slug}/`}>{slug.replaceAll('-',' ')}</a></li>)}</ul></nav></article></BaseLayout>
