---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BookCover from '../../components/BookCover.astro';
import { books } from '../../data/books';

export function getStaticPaths() {
  return books
    .filter(book => !['the-5g-home-internet-troubleshooting-manual','ai-scam-defence-for-families','the-reactive-dog-walking-playbook','busy-dog-better-day','dog-enrichment-for-apartments-and-busy-owners','cooperative-care-for-dog-owners','the-rescue-dog-first-90-days','the-new-heat-pump-owners-operating-manual','automate-the-office','private-ai-on-your-pc','your-first-20-nights-with-a-telescope','deep-sky-astrophotography-troubleshooting','construction-estimating-for-your-first-jobs','landscape-contractor-estimating-and-pricing','the-home-assistant-and-matter-owners-manual','break-through-your-genealogy-brick-wall','so-youve-volunteered-to-coach-soccer','ham-radio-technician-exam-prep-2026-2030','epa-608-universal-certification-exam-prep-2027','whats-wrong-with-my-aquarium'].includes(book.slug))
    .map(book => ({ params: { slug: book.slug }, props: { book } }));
}

const { book } = Astro.props;
const schema = {
  '@context':'https://schema.org',
  '@type':'Book',
  name:book.title,
  alternativeHeadline:book.subtitle,
  author:{'@type':'Person',name:book.author,url:'https://mercerlanepress.com/authors/' + book.authorSlug + '/'},
  publisher:{'@type':'Organization',name:book.publisher,url:'https://mercerlanepress.com/'},
  description:book.description,
  url:'https://mercerlanepress.com/books/' + book.slug + '/'
};
---
<BaseLayout title={book.title} description={book.description} image={book.coverReady ? book.cover : undefined} schema={schema}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Books',href:'/books/'},{name:book.title}]}/>
  <section class="wrap book-layout">
    <BookCover book={book} large/>
    <div>
      <p class="eyebrow">PRACTICAL GUIDE</p>
      <h1>{book.title}</h1>
      <p class="lede">{book.subtitle}</p>
      <p>By <a href={'/authors/' + book.authorSlug + '/'}>{book.author}</a> · Published by {book.publisher}</p>
      <p>{book.description}</p>
      <div class="actions">
        <a class="button" href={book.purchaseUrl}>Buy on Amazon</a>
        {book.hubSlug && <a class="button button-secondary" href={'/' + book.hubSlug + '/'}>Read free guides</a>}
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">WHO IT IS FOR</p>
        <h2>A practical system for a specific job</h2>
        <p>{book.intendedReader}</p>
      </div>
      {book.problems?.length && <><h2>Problems the book helps you work through</h2><ul class="check-grid">{book.problems.map((item:string)=><li>{item}</li>)}</ul></>}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">INSIDE THE SYSTEM</p><h2>What the book focuses on</h2></div>
      <div class="grid-3">
        {book.topics?.slice(0,6).map((topic:string)=><article class="card"><h3>{topic}</h3><p>Use clear evidence, practical checks, and documented facts rather than unsupported assumptions.</p></article>)}
      </div>
      <div class="notice"><strong>No guaranteed AI rankings.</strong> Search and AI systems change, and no method can guarantee that a platform will mention, cite, rank, recommend, or prefer a business. The goal is to improve the quality, consistency, accessibility, and testability of the public evidence about the business.</div>
    </div>
  </section>

  {book.outcomes?.length && <section class="section section-tint"><div class="wrap"><div class="section-head"><p class="eyebrow">PRACTICAL OUTCOMES</p><h2>What the 30-day system is designed to leave you with</h2></div><div class="grid-3">{book.outcomes.map((item:string)=><article class="card"><h3>{item}</h3><p>A repeatable operating habit rather than a one-off optimization tactic.</p></article>)}</div></div></section>}
</BaseLayout>
