---
import BaseLayout from '../layouts/BaseLayout.astro'; import BookCover from '../components/BookCover.astro'; import { featuredBook, books } from '../data/books';
const schema={'@context':'https://schema.org','@type':'WebSite',name:'Mercer Lane Press',url:'https://mercerlanepress.com/',description:'Independent publisher of practical problem-solving nonfiction.'};
const moreBooks=books.filter(book=>book.slug!==featuredBook.slug);
---
<BaseLayout title="Mercer Lane Press | Practical problem-solving books" description="Mercer Lane Press publishes practical nonfiction guides that turn confusing problems into clear, repeatable steps." schema={schema}>
<section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><p class="eyebrow">PRACTICAL NONFICTION</p><h1>Clear systems for problems worth solving.</h1><p class="lede">Mercer Lane Press publishes focused guides for readers who want to understand what is happening, test the right things, and move forward with confidence.</p><div class="actions"><a class="button" href="/books/">Browse our books</a><a class="button button-secondary" href="/guides/">Read practical guides</a></div></div><BookCover book={featuredBook}/></div></section>
<section class="section"><div class="wrap"><div class="section-head"><p class="eyebrow">FEATURED BOOK</p><h2>{featuredBook.title}</h2><p>{featuredBook.description}</p></div><div class="grid-3"><article class="card"><h3>Start with the system</h3><p>Separate the cellular link from home Wi-Fi, then trace symptoms through five diagnostic layers.</p></article><article class="card"><h3>Make evidence useful</h3><p>Use controlled tests and careful observations instead of repeatedly changing settings.</p></article><article class="card"><h3>Buy hardware last</h3><p>Learn which checks to perform before deciding whether another device can actually help.</p></article></div><div class="actions"><a class="button" href={'/books/' + featuredBook.slug + '/'}>Explore the book</a></div></div></section>
{moreBooks.length > 0 && <section class="section section-tint"><div class="wrap"><div class="section-head"><p class="eyebrow">MORE FROM MERCER LANE PRESS</p><h2>Practical systems for other problems</h2></div>{moreBooks.map(book=><article class="book-layout"><BookCover book={book}/><div><h2>{book.title}</h2><p><strong>{book.subtitle}</strong></p><p>{book.description}</p><div class="actions"><a class="button" href={'/books/' + book.slug + '/'}>Explore the book</a>{book.hubSlug && <a class="button button-secondary" href={'/' + book.hubSlug + '/'}>Read free guides</a>}</div></div></article>)}</div></section>}
<section class="section"><div class="wrap"><div class="section-head"><p class="eyebrow">USEFUL RESOURCES</p><h2>Start with the problem you need to solve</h2><p>Browse practical guide collections across the main topics covered by Mercer Lane Press.</p></div><div class="grid-3">
<article class="card"><p class="eyebrow">HOME INTERNET</p><h3><a href="/5g-home-internet/">5G Home Internet</a></h3><p>Signal, speed, disconnects, gateway placement, Wi-Fi, and provider-side troubleshooting.</p></article>
<article class="card"><p class="eyebrow">DOG GUIDES</p><h3><a href="/dog-guides/">Dog Guides</a></h3><p>Rescue-dog settling, reactive walking, enrichment, cooperative care, handling, and everyday routines.</p></article>
<article class="card"><p class="eyebrow">HOME HEATING</p><h3><a href="/heat-pump-owners/">Heat Pump Owners</a></h3><p>Controls, weather compensation, defrost, comfort, electricity use, and owner-level troubleshooting.</p></article>
<article class="card"><p class="eyebrow">OFFICE AUTOMATION</p><h3><a href="/power-automate/">Microsoft Power Automate</a></h3><p>Outlook, SharePoint, Forms, Excel, Teams, approvals, reminders, troubleshooting, and maintenance.</p></article>
<article class="card"><p class="eyebrow">LOCAL BUSINESS</p><h3><a href="/local-business-ai/">AI Visibility for Local Businesses</a></h3><p>Business facts, service-page clarity, crawlability, testing, and measuring AI visibility.</p></article>
<article class="card"><p class="eyebrow">FAMILY SAFETY</p><h3><a href="/ai-scam-defence/">AI Scam Defence</a></h3><p>Practical routines for pausing, verifying suspicious requests, protecting accounts, and responding to impersonation scams.</p></article>
</div><div class="actions"><a class="button button-secondary" href="/guides/">View all guide topics</a></div></div></section>
<section class="section section-tint"><div class="wrap prose"><p class="eyebrow">OUR APPROACH</p><h2>Reference books designed for use</h2><p>We organize practical nonfiction around decisions, tests, and next steps—not filler. Each guide aims to help a reader distinguish similar-looking causes, keep useful notes, and know when an issue is outside their control.</p></div></section></BaseLayout>
