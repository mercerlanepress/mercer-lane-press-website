---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import { bookSeoBySlug } from '../data/book-seo';
import { bookSeoSearchConsoleOverrides } from '../data/book-seo-search-console';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  schema?: object | object[];
  robots?: string;
  sensitiveTool?: boolean;
}

const { title, description, image = '/social-card.svg', type = 'website', schema, robots, sensitiveTool = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const bookMatch = Astro.url.pathname.match(/^\/books\/([^/]+)\/?$/);
const bookSeo = bookMatch
  ? bookSeoSearchConsoleOverrides[bookMatch[1]] ?? bookSeoBySlug[bookMatch[1]]
  : undefined;
const effectiveDescription = bookSeo?.metaDescription ?? description;
const fullTitle = bookSeo?.seoTitle ?? (title.includes('Mercer Lane Press') ? title : `${title} | Mercer Lane Press`);
const organizationLogo = new URL('/logo.svg', Astro.site).href;

const addOrganizationLogo = (value: any): any => {
  if (Array.isArray(value)) return value.map(addOrganizationLogo);
  if (!value || typeof value !== 'object') return value;

  const mapped = Object.fromEntries(
    Object.entries(value).map(([key, child]) => [key, addOrganizationLogo(child)])
  ) as Record<string, any>;

  if (
    mapped['@type'] === 'Organization' &&
    mapped.name === 'Mercer Lane Press' &&
    !mapped.logo
  ) {
    mapped.logo = organizationLogo;
  }

  return mapped;
};

const keywordEnhancedSchema = schema && bookSeo
  ? Array.isArray(schema)
    ? schema.map(item => ({ ...item, keywords: bookSeo.keywords.join(', ') }))
    : { ...schema, keywords: bookSeo.keywords.join(', ') }
  : schema;
const enhancedSchema = keywordEnhancedSchema ? addOrganizationLogo(keywordEnhancedSchema) : keywordEnhancedSchema;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Mercer Lane Press',
  url: 'https://mercerlanepress.com/',
  logo: organizationLogo
};
const measurementId = 'G-CK9SW6VRS9';
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <meta name="generator" content={Astro.generator}>
    <title>{fullTitle}</title>
    <meta name="description" content={effectiveDescription}>
    {robots && <meta name="robots" content={robots}>}
    <link rel="canonical" href={canonical}>
    <meta property="og:type" content={type}>
    <meta property="og:title" content={fullTitle}>
    <meta property="og:description" content={effectiveDescription}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={new URL(image, Astro.site)}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={fullTitle}>
    <meta name="twitter:description" content={effectiveDescription}>
    <meta name="theme-color" content="#10233f">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">

    {!sensitiveTool && <script is:inline define:vars={{ measurementId }}>
      (() => {
        const storageKey = 'mlp-analytics-consent';
        const savedChoice = localStorage.getItem(storageKey);

        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };

        window.gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: savedChoice === 'granted' ? 'granted' : 'denied',
          wait_for_update: 500
        });

        window.gtag('js', new Date());
        window.gtag('config', measurementId, {
          anonymize_ip: true
        });
      })();
    </script>}
    {!sensitiveTool && <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-CK9SW6VRS9"></script>}
    {sensitiveTool && <script is:inline define:vars={{ measurementId }}>
      (() => {
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
        window.gtag('consent', 'default', {ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied'});
        let loaded = false;
        const enable = () => {
          if (loaded) return;
          loaded = true;
          window.gtag('js', new Date());
          window.gtag('config', measurementId, {send_page_view:false,allow_google_signals:false,allow_ad_personalization_signals:false});
          const script = document.createElement('script');
          script.async = true; script.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId;
          document.head.append(script);
        };
        window.addEventListener('mlp:analytics-consent', event => { if (event.detail === 'granted') enable(); });
        try {
          if (localStorage.getItem('mlp-analytics-consent') === 'granted') {
            window.gtag('consent','update',{analytics_storage:'granted'}); enable();
            window.gtag('event','page_view',{page_title:document.title,page_location:location.origin+location.pathname,page_path:location.pathname});
          }
        } catch { /* No storage: analytics remains off. */ }
      })();
    </script>}

    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    {enhancedSchema && <script type="application/ld+json" set:html={JSON.stringify(enhancedSchema)} />}
  </head>
  <body>
    <Header/>
    <main id="main-content">
      <slot />
      {bookSeo && <section class="section section-tint" aria-labelledby="search-intent-heading">
        <div class="wrap narrow">
          <div class="section-head">
            <p class="eyebrow">SEARCH BY THE PROBLEM</p>
            <h2 id="search-intent-heading">{bookSeo.heading}</h2>
            <p>{bookSeo.intro}</p>
          </div>
          <h3>Questions this guide is designed to help with</h3>
          <ul class="check-grid">
            {bookSeo.questions.map(question => <li>{question}</li>)}
          </ul>
        </div>
      </section>}
    </main>
    <Footer/>
    <AnalyticsConsent/>
  </body>
</html>
