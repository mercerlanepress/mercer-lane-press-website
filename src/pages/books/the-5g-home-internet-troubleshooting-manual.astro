---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import BookCover from '../../components/BookCover.astro'; import GuideCard from '../../components/GuideCard.astro'; import {getCollection} from 'astro:content'; import {featuredBook as book} from '../../data/books';
const guides=(await getCollection('guides')).sort((a,b)=>a.data.order-b.data.order);
const schema={'@context':'https://schema.org','@type':'Book',name:book.title,alternativeHeadline:book.subtitle,author:{'@type':'Person',name:book.author,url:'https://mercerlanepress.com/authors/mercer-lane/'},publisher:{'@type':'Organization',name:book.publisher},description:book.description,url:`https://mercerlanepress.com/books/${book.slug}/`};
const problems=['Weak or fluctuating cellular signal','Unstable or unexpectedly slow speeds','Wi-Fi dead zones and band problems','Latency, jitter, packet loss, and loaded latency','Time-of-day congestion and outages','Gaming, calls, streaming, and smart-device trouble'];
---
<BaseLayout title={book.title} description={book.description} schema={schema}><Breadcrumbs items={[{name:'Home',href:'/'},{name:'Books',href:'/books/'},{name:book.title}]}/><section class="wrap book-layout"><BookCover book={book} large/><div><p class="eyebrow">A PROVIDER-NEUTRAL MANUAL</p><h1>{book.title}</h1><p class="lede">{book.subtitle}</p><p>By <a href="/authors/mercer-lane/">{book.author}</a> · Published by {book.publisher}</p><p>This guide teaches a measured way to find the source of 5G home internet trouble—before you reset everything, change several settings at once, or buy equipment that may not address the cause.</p><p><strong>Isolate before you optimize.</strong></p><div class="actions">{book.purchaseUrl ? <a class="button" href={book.purchaseUrl}>Buy on Amazon</a> : <span class="button" aria-disabled="true">Purchase link coming soon</span>}<a class="button button-secondary" href="#inside">See what’s inside</a></div><p><small>The purchase link will be activated when an official retailer URL is available.</small></p></div></section>
<section class="section section-tint"><div class="wrap"><div class="section-head"><p class="eyebrow">WHO IT IS FOR</p><h2>A guide for readers who need answers, not guesses</h2><p>For 5G home internet users dealing with inconsistent service, confusing signal readings, coverage gaps, or applications that do not perform as expected. No carrier-specific setup is assumed.</p></div><h2>Problems it helps diagnose</h2><ul class="check-grid">{problems.map(x=><li>{x}</li>)}</ul></div></section>
<section class="section" id="inside"><div class="wrap prose"><p class="eyebrow">THE CENTRAL DISTINCTION</p><h2>One connection, two wireless systems</h2><p>A 5G home internet setup joins a cellular link—from the provider network to the gateway—to a local Wi-Fi link—from the gateway to your devices. A weak cellular link and weak bedroom Wi-Fi can look alike from the couch, but require different fixes. The manual shows how to test them separately.</p><h2>The five-layer diagnostic model</h2><ol class="layers"><li><strong>Provider network</strong> — availability, outages, and congestion</li><li><strong>Cellular radio link</strong> — signal quality, placement, and obstructions</li><li><strong>Gateway</strong> — firmware, heat, power, and operating state</li><li><strong>Home network</strong> — Wi-Fi bands, Ethernet, mesh, and extenders</li><li><strong>Device or application</strong> — one-device faults and workload requirements</li></ol></div></section>
<section class="section section-tint"><div class="wrap"><div class="section-head"><p class="eyebrow">WHAT READERS WILL LEARN</p><h2>From first observation to a stability test</h2></div><div class="grid-3"><article class="card"><h3>Measure clearly</h3><p>Interpret signal metrics, speed variation, latency, jitter, packet loss, and loaded latency without treating a single test as the whole answer.</p></article><article class="card"><h3>Test deliberately</h3><p>Score gateway placements, compare Wi-Fi and Ethernet, keep a troubleshooting log, and use symptom matrices and worked scenarios.</p></article><article class="card"><h3>Choose the next step</h3><p>Work through a rapid sequence, run a seven-day stability test, and present useful evidence to provider support.</p></article></div><div class="notice"><strong>Independent and provider-neutral.</strong> This book is not affiliated with, sponsored by, or endorsed by any carrier, ISP, gateway manufacturer, router manufacturer, or testing service. Follow provider and device-manufacturer safety and installation instructions.</div></div></section>
<section class="section"><div class="wrap"><div class="section-head"><p class="eyebrow">RELATED FREE GUIDES</p><h2>Start troubleshooting now</h2></div><div class="grid-3">{guides.slice(0,3).map(g=><GuideCard guide={g}/>)}</div></div></section></BaseLayout>
