---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const { entry } = Astro.props;
const { title, description, published, related } = entry.data;
const url = new URL('/over-aroused-dog/' + entry.id + '/', Astro.site).href;
const schema = {
  '@context':'https://schema.org',
  '@type':'Article',
  headline:title,
  description,
  datePublished:published.toISOString().slice(0,10),
  author:{'@type':'Person',name:'Sophie Ardenwood',url:'https://mercerlanepress.com/authors/sophie-ardenwood/'},
  publisher:{'@type':'Organization',name:'Mercer Lane Press',url:'https://mercerlanepress.com/'},
  mainEntityOfPage:url
};
---
<BaseLayout title={title} description={description} type="article" schema={schema}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Dog Guides',href:'/dog-guides/'},{name:'Over-Aroused Dog',href:'/over-aroused-dog/'},{name:title}]}/>
  <article class="article wrap narrow">
    <header>
      <p class="eyebrow">OVER-AROUSED DOG GUIDE</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="byline">By <a href="/authors/sophie-ardenwood/">Sophie Ardenwood</a> · Published <time datetime={published.toISOString()}>{published.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></p>
    </header>
    <div class="article-body"><slot /></div>
    <aside class="book-note">
      <p class="eyebrow">BUILD THE FULL CALMNESS SYSTEM</p>
      <h2>Move from one difficult moment to a repeatable plan</h2>
      <p><em>The Over-Aroused Dog</em> brings together load reduction, escalation and recovery tracking, calm-skill training, real-life generalization, a four-week implementation plan, troubleshooting tools, safety boundaries, and long-term maintenance.</p>
      <a class="button" href="/books/the-over-aroused-dog/">Explore the book</a>
    </aside>
    <nav class="related" aria-label="Related over-aroused dog guides"><h2>Related over-aroused dog guides</h2><ul>{related.map((slug:string) => <li><a href={'/over-aroused-dog/' + slug + '/'}>{slug.replaceAll('-',' ')}</a></li>)}</ul></nav>
  </article>
</BaseLayout>
