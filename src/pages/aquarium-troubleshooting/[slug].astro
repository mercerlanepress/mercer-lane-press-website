---
import { getCollection, render } from 'astro:content';
import AquariumTroubleshootingArticleLayout from '../../layouts/AquariumTroubleshootingArticleLayout.astro';

export async function getStaticPaths(){
  return (await getCollection('aquariumTroubleshootingGuides')).map(entry => ({params:{slug:entry.id},props:{entry}}));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<AquariumTroubleshootingArticleLayout entry={entry}><Content /></AquariumTroubleshootingArticleLayout>
