---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
const schema = {"@context": "https://schema.org", "@type": "WebApplication", "name": "Construction Job Profit Calculator", "applicationCategory": "BusinessApplication", "operatingSystem": "Web browser", "url": "https://mercerlanepress.com/tools/construction-job-profit-calculator/", "description": "Free contractor job profit calculator for gross profit, margin, markup, break-even revenue, target-margin revenue and estimate-versus-actual job costing.", "offers": {"@type": "Offer", "price": "0", "priceCurrency": "USD"}};
const faqSchema = {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
  {"@type":"Question","name":"How do I calculate profit on a construction job?","acceptedAnswer":{"@type":"Answer","text":"Add the job revenue, subtract direct job costs such as materials, labour, subcontractors, equipment and other job-specific costs, then account for the job's chosen overhead allocation if you want a result after overhead."}},
  {"@type":"Question","name":"How do I calculate construction job profit margin?","acceptedAnswer":{"@type":"Answer","text":"Profit margin is profit divided by revenue. For example, $10,000 profit on $40,000 revenue is a 25% margin. Markup uses cost as the denominator instead, so markup and margin are not the same."}},
  {"@type":"Question","name":"How much revenue do I need for a target profit margin?","acceptedAnswer":{"@type":"Answer","text":"Divide total cost by one minus the target margin expressed as a decimal. For example, $33,000 total cost at a 25% target margin requires $44,000 revenue."}},
  {"@type":"Question","name":"What is profit fade on a construction job?","acceptedAnswer":{"@type":"Answer","text":"Profit fade is a reduction in expected job profit as actual or forecast costs and revenue change from the original estimate. Comparing the accepted estimate with updated forecast or final figures helps show where the profit changed."}},
  {"@type":"Question","name":"Can I use a job profit calculator while work is in progress?","acceptedAnswer":{"@type":"Answer","text":"Yes, if you enter forecast final costs rather than only costs spent so far. Include incurred costs plus the expected cost to finish so an incomplete job does not look artificially profitable."}}
]};
---
<BaseLayout title="Construction Job Profit Calculator: Margin & Estimate vs Actual" description="Free contractor job profit calculator for profit, margin, markup, break-even and target-margin revenue. Compare estimated versus actual or forecast costs." schema={[schema, faqSchema]} sensitiveTool>
<Breadcrumbs items={[{name:'Home',href:'/'},{name:"Construction Job Profit Calculator"}]}/>
<link rel="stylesheet" href="/tools-assets/job-profit/calculator.css"/><div class="job-tool"><div class="tool-body"><header><p class="brand">MERCER LANE PRESS</p><h1>Construction Job Profit Calculator</h1><p class="intro">Check a contractor job's revenue, costs, gross profit, margin, markup and break-even point. Compare estimated versus actual or forecast figures, and see the revenue required to reach your chosen target margin. Blank inputs count as zero.</p></header><section class="calc" aria-labelledby="calculator-heading"><h2 id="calculator-heading">Check your job</h2><p class="muted">All amounts are US dollars. Include only approved changes in revenue. Use the same cost and tax basis throughout. Values stay in this browser page and are not uploaded or stored.</p><label class="toggle"><input type="checkbox" id="compare-mode"> Compare estimated versus actual</label><form id="job-form" novalidate><div class="grid"><div><fieldset><legend>Actual / forecast revenue ($)</legend><label for="a-original">Original quote / contract value<input id="a-original" name="a-original" type="number" min="0" max="1000000000000" step="any" inputmode="decimal" placeholder="0"></label><label for="a-changes">Approved change orders<input id="a-changes" name="a-changes" type="number" min="0" max="1000000000000" step="any" inputmode="decimal" placeholder="0"></label></fieldset><fieldset><legend>Actual / forecast costs ($)</legend><label for="a-materials">Materials<input id="a-materials" type="number" min="0" max="1000000000000" step="any" inputmode="decimal" placeholder="0"></label><label for="a-labour">Labour<input id="a-labour" type="number" min="0" max="1000000000000" step="any" inputmode="decimal" placeholder="0"></label><label for="a-subcontractors">Subcontractors<input id="a-subcontractors" type="number" min="0" max="1000000000000" step="any" inputmode="decimal" placeholder="0"></label><label for="a-equipment">Equipment / plant<input id="a-equipment" type="number" min="0" max="1000000000000" step="any" inputmode="decimal" placeholder="0"></label><label for="a-other">Other job costs<input id="a-other" type="number" min="0" max="1000000000000" step="any" inputmode="decimal" placeholder="0"></label><label for="a-overhead">Company overhead allocation (optional)<input id="a-overhead" type="number" min="0" max="1000000000000" step="any" inputmode="decimal" placeholder="0"></label></fieldset><fieldset><legend>Target margin check</legend><label for="target-margin">Target margin after overhead (%)<input id="target-margin" type="number" min="0" max="99.99" step="0.01" inputmode="decimal" value="25" required></label><p class="muted">Used only to calculate the revenue required at the costs entered. It does not recommend what your target margin should be.</p></fieldset><div id="estimated-inputs" hidden><fieldset><legend>Estimated revenue ($)</legend><label for="e-original">Original quote / contract value<input id="e-original" name="e-original" type="number" min="0" max="1000000000000" step="any" inputmode="decimal" placeholder="0"></label><label for="e-changes">Approved change orders<input id="e-changes" name="e-changes" type="number" min="0" max="1000000000000" step="any" inputmode="decimal" placeholder="0"></label></fieldset><fieldset><legend>Estimated costs ($)</legend><label for="e-materials">Materials<input id="e-materials" type="number" min="0" max="1000000000000" step="any" inputmode="decimal" placeholder="0"></label><label for="e-labour">Labour<input id="e-labour" type="number" min="0" max="1000000000000" step="any" inputmode="decimal" placeholder="0"></label><label for="e-subcontractors">Subcontractors<input id="e-subcontractors" type="number" min="0" max="1000000000000" step="any" inputmode="decimal" placeholder="0"></label><label for="e-equipment">Equipment / plant<input id="e-equipment" type="number" min="0" max="1000000000000" step="any" inputmode="decimal" placeholder="0"></label><label for="e-other">Other job costs<input id="e-other" type="number" min="0" max="1000000000000" step="any" inputmode="decimal" placeholder="0"></label><label for="e-overhead">Company overhead allocation (optional)<input id="e-overhead" type="number" min="0" max="1000000000000" step="any" inputmode="decimal" placeholder="0"></label></fieldset></div><button type="submit">Calculate job profit</button><button type="button" class="secondary" id="example">Load example</button><button type="button" class="secondary" id="clear-inputs">Clear inputs</button><p id="error" class="error" role="alert" hidden></p></div><section class="results" aria-labelledby="results-heading"><h3 id="results-heading">Job results</h3><p id="state">Enter your job values, then calculate.</p><div id="results" hidden aria-live="polite" aria-atomic="true"></div></section></div><section id="comparison" hidden aria-labelledby="comparison-heading"><h3 id="comparison-heading">Estimated versus actual</h3><div id="compare-results" class="table-wrap"></div></section></form></section><section class="copy"><h2>What does your job profit mean?</h2><p>Revised revenue is the original contract plus approved change orders. Direct job costs include materials, labour, subcontractors, equipment and other job expenses. Gross profit is revenue less those direct costs. If you enter company overhead, contribution after overhead shows what remains after that allocation.</p><p>A positive result gives a cost cushion before the job becomes loss-making. A negative result shows how far costs exceed revenue. Neither result tells you how much cash is in the bank: customer invoices, cash received and unpaid supplier bills are separate questions.</p><h2>A worked construction example</h2><p>A contractor quotes $40,000 and obtains approval for $1,500 of additional work. Final costs are $10,000 materials, $12,000 labour, $5,000 subcontractors, $1,000 equipment and $2,000 other costs. Revised revenue is $41,500 and direct cost is $30,000. Gross profit is $11,500 and gross margin is 27.71%.</p><p>With $3,000 allocated company overhead, total cost becomes $33,000, contribution is $8,500 and margin after overhead is 20.48%. Markup on total cost is 25.76%. At a fictional 25% target margin, $33,000 of total cost would require $44,000 of revenue. These figures demonstrate the method and are not recommended prices or rates.</p><h2>How to calculate the revenue needed for a target margin</h2><p>When you know the total job cost including the overhead allocation you want to recover, the target-margin formula is <strong>required revenue = total cost ÷ (1 − target margin)</strong>. A 25% margin is not the same as adding a 25% markup. For example, $33,000 of total cost divided by 0.75 gives $44,000 of required revenue for a 25% margin.</p><p>This is a check on the figures you enter, not a recommendation for the margin your business should use. Your pricing still needs to reflect your own overhead, risk, capacity, market and commercial requirements.</p><h2>Compare your estimate with actual costs</h2><p>Switch on the comparison to enter your original assumptions alongside the job's actual or forecast result. A positive cost variance means costs increased; a negative cost variance means costs decreased. Profit variance works in the opposite direction: positive means more profit, negative means less.</p><p>For an active job, include both incurred costs and your expected remaining costs. Entering only today's spending can make an unfinished job look more profitable than it is. Check what changed in scope, quantities, prices and labour hours before adjusting future estimates.</p><p>This estimate-versus-actual comparison can also expose <strong>profit fade</strong>: expected profit shrinking as cost overruns, unpriced scope, labour inefficiency or other changes emerge. A favourable or unfavourable variance is a signal to investigate the job records, not a diagnosis by itself.</p><h2>Margin versus markup</h2><p>Margin measures profit as a share of revenue. Markup measures profit as a share of cost. Cost of $100 and price of $125 produces $25 profit: 20% margin and 25% markup. Percentages are undefined when their denominator is zero, so the calculator shows an em dash.</p><div class="cta"><h2>Manage the whole job lifecycle</h2><p>The calculator evaluates one job. Mercer Lane Construction Estimating &amp; Job Costing Toolkit PRO helps you build estimates, create quotes, capture accepted baselines, track incurred costs and changes, forecast profit, compare estimate versus actual and review completed jobs across a portfolio.</p><a href="/tools/construction-estimating-system-pro/" id="product-cta">Explore Toolkit PRO — US$19.99</a><p id="product-details" class="muted">The complete v3.2 package includes separate Estimate &amp; Quote Builder and Job Cost &amp; Profit Control workbooks, worked demos, five bonus tools, forms and guides. One-time purchase: US$19.99 plus applicable tax. The toolkit runs in Excel desktop. It supports your estimating and job reviews; it does not replace your accounting system.</p></div><h2>Frequently asked questions</h2><details><summary>How do I calculate profit on a construction job?</summary><p>Add the job revenue, subtract direct job costs such as materials, labour, subcontractors, equipment and other job-specific costs, then account for the job's chosen overhead allocation if you want a result after overhead.</p></details><details><summary>How do I calculate construction job profit margin?</summary><p>Profit margin is profit divided by revenue. For example, $10,000 profit on $40,000 revenue is a 25% margin. Markup uses cost as the denominator instead, so margin and markup are different percentages.</p></details><details><summary>How much revenue do I need for a target profit margin?</summary><p>Divide total cost by one minus the target margin expressed as a decimal. For example, $33,000 total cost at a 25% target margin requires $44,000 revenue.</p></details><details><summary>What is profit fade on a construction job?</summary><p>Profit fade is a reduction in expected job profit as actual or forecast costs and revenue change from the original estimate. Comparing the accepted estimate with updated forecast or final figures helps show where the profit changed.</p></details><details><summary>Which costs should I include?</summary><p>Include costs incurred for the job, including supplier and subcontractor invoices that have not yet been paid. Use an internal burdened labour cost rate if that is how you estimate. Include nonrecoverable purchase tax once; use a consistent revenue basis that excludes tax collected for remittance.</p></details><details><summary>Can I use this while a job is in progress?</summary><p>Yes. Enter your forecast final costs, including what you expect to spend to finish. This gives a forecast result rather than a completed actual result.</p></details><details><summary>Do pending changes increase revenue?</summary><p>Only enter approved change orders. Work delivered before pricing or approval can reduce profit even when you hope to bill it later.</p></details><details><summary>Is gross profit the same as cash received?</summary><p>No. Profit compares revenue with costs. Cash received is customer money collected. You can show profit and still be waiting for payment.</p></details><details><summary>Is my information saved or uploaded?</summary><p>No. The calculator processes job inputs in this page and requires no account. Job values are not sent to Mercer Lane Press or analytics. The website has optional analytics controlled by your cookie choice. Reloading or clearing the page removes your entries.</p></details></section><footer>Mercer Lane Press. Calculation aid only. No accounting, financial or tax advice. No guaranteed profit or estimate accuracy.</footer></div></div><script is:inline type="module" src="/tools-assets/job-profit/calculator.js"></script>
</BaseLayout>
