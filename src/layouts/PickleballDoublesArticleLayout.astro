---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const { entry } = Astro.props;
const { title, description, published, related } = entry.data;
const url = new URL('/pickleball-doubles/' + entry.id + '/', Astro.site).href;
const schema = {
  '@context':'https://schema.org',
  '@type':'Article',
  headline:title,
  description,
  datePublished:published.toISOString().slice(0,10),
  author:{'@type':'Organization',name:'Mercer Lane Press',url:'https://mercerlanepress.com/'},
  publisher:{'@type':'Organization',name:'Mercer Lane Press',url:'https://mercerlanepress.com/'},
  mainEntityOfPage:url
};
---
<BaseLayout title={title} description={description} type="article" schema={schema}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Pickleball Doubles',href:'/pickleball-doubles/'},{name:title}]}/>
  <article class="article wrap narrow">
    <header>
      <p class="eyebrow">PICKLEBALL DOUBLES STRATEGY</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="byline">By Mercer Lane Press · Published <time datetime={published.toISOString()}>{published.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></p>
    </header>
    <div class="article-body"><slot /></div>
    <aside class="book-note">
      <p class="eyebrow">THE COMPLETE COURTSIDE SYSTEM</p>
      <h2>Connect the next shot to the next team decision</h2>
      <p><em>Pickleball Doubles Decisions</em> by Julian Rooke expands these ideas across opening-ball choices, transition, NVZ play, partner movement, opponent patterns, rally repair, and quick-reference decision cards.</p>
      <a class="button" href="/books/pickleball-doubles-decisions/">Explore the book</a>
    </aside>
    <nav class="related" aria-label="Related pickleball doubles guides"><h2>Related pickleball doubles guides</h2><ul>{related.map((slug:string) => <li><a href={'/pickleball-doubles/' + slug + '/'}>{slug.replaceAll('-',' ')}</a></li>)}</ul></nav>
    <div class="notice"><strong>Scope.</strong> These pages discuss general pickleball strategy, not medical advice or officiating. Rules can change; use the current official rulebook and event regulations for competition.</div>
  </article>
</BaseLayout>