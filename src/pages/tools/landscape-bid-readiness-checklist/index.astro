---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';

const passes = [
  {
    title: '1 · Scope',
    note: 'Confirm the job you are promising before you price it.',
    checks: [
      'The customer-facing work description identifies the actual installation, site area, finish and acceptance requirements.',
      'Exclusions and customer responsibilities are written down rather than assumed.',
      'Access, ground conditions, utilities, permits, approved designs and unresolved site risks have been checked or flagged for action.'
    ]
  },
  {
    title: '2 · Quantify',
    note: 'Measure first; convert to purchasing quantities separately.',
    checks: [
      'Area, length, volume, plant counts, loads and other takeoff quantities are recorded with units.',
      'Waste, coverage, compaction where relevant, pack sizes, minimum orders and purchase rounding have been considered.',
      'Supplier units and quotations match the quantities the company will actually purchase.'
    ]
  },
  {
    title: '3 · Time',
    note: 'Estimate operations and productive labor-hours, not just calendar days.',
    checks: [
      'Installation, preparation, loading, unloading, collection, cleanup and other operations have labor-hour allowances.',
      'Labor rates reflect the company’s chosen treatment of wage burden, paid hours and productive hours.',
      'Crew size, access limits and likely production bottlenecks are reflected in the time assumptions.'
    ]
  },
  {
    title: '4 · Cost',
    note: 'Give real resources one deliberate home in the estimate.',
    checks: [
      'Materials use current company-specific purchase costs, including applicable delivery and handling.',
      'Field labor is costed under the company’s documented labor method.',
      'Owned or rented machinery, truck/trailer resources and associated charges have been considered.',
      'Subcontractors, travel, mobilization, disposal, permit fees and other job-specific costs have been considered.'
    ]
  },
  {
    title: '5 · Price',
    note: 'Make the model visible and avoid recovering any cost twice.',
    checks: [
      'Overhead recovery is included using a defined method, with no material double counting.',
      'Known risks, assumptions, allowances and unresolved scope are treated explicitly instead of hidden inside one large percentage.',
      'The chosen markup or target margin is applied to the correct cost base; markup and margin are not confused.'
    ]
  },
  {
    title: '6 · Check & Learn',
    note: 'Review the bid now and preserve evidence for the next one.',
    checks: [
      'The client quote, exclusions, tax treatment, options and validity match the reviewed internal estimate.',
      'A final bid review has tested scope, quantities, time, costs, overhead, price and risks.',
      'The accepted estimate will be preserved and compared against actual costs and labor-hours after the job.'
    ]
  }
];
const total = passes.reduce((count, pass) => count + pass.checks.length, 0);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Free Landscape Contractor Bid Readiness Checklist',
  url: 'https://mercerlanepress.com/tools/landscape-bid-readiness-checklist/',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any',
  isAccessibleForFree: true,
  description: 'A free printable six-pass landscaping estimate and bid review checklist covering scope, quantities, labor, equipment, overhead, markup, margin and post-job learning.'
};
---
<BaseLayout
  title="Free Landscape Bid Checklist | Review Your Estimate Before Quoting"
  description="Free printable landscape contractor bid checklist. Review scope, takeoff, labor-hours, equipment, overhead, markup and margin before sending a landscaping quote."
  schema={schema}
  sensitiveTool
>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Tools',href:'/tools/'},{name:'Landscape Bid Checklist'}]}/>
  <header class="page-head wrap">
    <p class="eyebrow">FREE LANDSCAPE CONTRACTOR TOOL</p>
    <h1>Landscape Bid Readiness Checklist</h1>
    <p class="lede">Before you send a landscaping quote, check the six places where missing assumptions can undermine your estimate. Use this list for a real project, one line at a time.</p>
    <p class="privacy">Free, no sign-up, no job figures requested. Your selections are held only in this open page, and reset on reload.</p>
  </header>

  <section class="section section-tint">
    <div class="wrap narrow">
      <div class="tool-intro">
        <div>
          <p class="eyebrow">SIX-PASS ESTIMATE</p>
          <h2>Scope → Quantify → Time → Cost → Price → Check &amp; Learn</h2>
          <p>Tick an item after verifying it against your records. A completed checklist is not proof the price is right; it is a review record showing which questions you considered.</p>
        </div>
        <div class="tool-meter" role="status" aria-live="polite">
          <strong id="checked-count">0 of {total}</strong>
          <span>items reviewed</span>
          <progress id="review-progress" value="0" max={total} aria-label="Checklist completion"></progress>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="checklist">
    <div class="wrap narrow">
      <form id="landscape-review-form">
        <div class="pass-list">
          {passes.map((pass, passIndex) =>
            <fieldset class="pass-card">
              <legend>{pass.title}</legend>
              <p class="pass-note">{pass.note}</p>
              {pass.checks.map((check, checkIndex) =>
                <label class="check-row">
                  <input
                    type="checkbox"
                    class="review-check"
                    name={'pass-' + (passIndex + 1) + '-item-' + (checkIndex + 1)}
                  />
                  <span>{check}</span>
                </label>
              )}
            </fieldset>
          )}
        </div>
        <div class="tool-actions">
          <button class="button" type="button" id="print-review">Print this checklist</button>
          <button class="button button-secondary" type="reset">Clear selections</button>
        </div>
        <p class="review-result" id="review-result" aria-live="polite">Start with scope. Tick only what you have checked.</p>
      </form>
      <div class="notice">
        <strong>This is a prompt for review, not an estimating formula.</strong>
        Prices, rates, labor-hours, approved designs, local rules, insurance and other inputs must come from your own company and qualified professionals where required. Do not treat a ticked checklist as engineering, legal, tax or accounting approval.
      </div>
    </div>
  </section>

  <section class="section section-tint no-print">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">FREE NEXT STEPS</p>
        <h2>Work through the item you are unsure about</h2>
        <p>These free resources explain the estimating decisions behind the checklist.</p>
      </div>
      <div class="grid-3">
        <article class="card"><h3>Estimate from scope, not a guess</h3><p>Follow the six-pass sequence for a landscape installation job.</p><a class="text-link" href="/landscape-contractor-estimating/">Read the six-pass guides →</a></article>
        <article class="card"><h3>Markup and margin are different</h3><p>Use the free calculator to check the arithmetic after defining your cost base.</p><a class="text-link" href="/tools/contractor-markup-margin-calculator/">Open markup and margin calculator →</a></article>
        <article class="card"><h3>Check estimated versus actual</h3><p>Compare a sold estimate with completed-job evidence to improve future bids.</p><a class="text-link" href="/landscape-contractor-estimating/landscape-estimate-versus-actual/">Read the job-cost review guide →</a></article>
      </div>
    </div>
  </section>

  <section class="section no-print">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">GO FURTHER WHEN YOU NEED TO</p>
        <h2>One method. Two separate products.</h2>
        <p>Choose the depth you need; the book and workbook are separate purchases.</p>
      </div>
      <div class="grid-2">
        <article class="card">
          <p class="eyebrow">BOOK · WARREN HOLTBY</p>
          <h3>Landscape Contractor Estimating &amp; Pricing</h3>
          <p>Learn the six-pass method with sixteen complete worked landscape estimates and reusable field worksheets.</p>
          <a class="button button-secondary" href="/books/landscape-contractor-estimating-and-pricing/">See the book and Amazon link</a>
        </article>
        <article class="card">
          <p class="eyebrow">EXCEL SYSTEM · MERCER LANE PRESS</p>
          <h3>Landscape Estimating &amp; Job Costing System</h3>
          <p>Build estimates, create a customer quote, freeze an awarded budget, record actual costs and review completed-job profit in the 27-sheet Excel desktop system.</p>
          <a class="button" href="/tools/landscape-estimating-job-costing-system/">See the Excel system and Etsy link</a>
          <p class="small">Microsoft Excel desktop required separately. Demo figures are fictional, not standard rates. See the product page for compatibility and capacity.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.privacy,.small{font-size:.9rem;color:var(--muted)}.tool-intro{display:grid;grid-template-columns:minmax(0,1fr) 170px;gap:1.5rem;align-items:center}
.tool-meter{padding:1.1rem;border:1px solid var(--line);border-radius:12px;background:var(--surface,white);display:flex;flex-direction:column;gap:.2rem}
.tool-meter strong{font-size:1.7rem;line-height:1.2}.tool-meter progress{width:100%;height:.7rem;margin-top:.8rem;accent-color:#3e7150}
.pass-list{display:grid;gap:1.2rem}.pass-card{min-width:0;margin:0;padding:1.2rem 1.4rem 1.4rem;border:1px solid var(--line);border-radius:12px;background:var(--surface,white)}
.pass-card legend{font-weight:750;font-size:1.3rem;padding:0 .5rem}.pass-note{margin:.1rem 0 1.1rem;color:var(--muted)}
.check-row{display:flex;align-items:flex-start;gap:.8rem;max-width:none;padding:.85rem 0;line-height:1.55;cursor:pointer}
.check-row+.check-row{border-top:1px solid var(--line)}
.check-row input{flex:0 0 20px;width:20px;height:20px;margin:.18rem 0 0;accent-color:#315e42}
.check-row span{flex:1;min-width:0}.check-row input:focus-visible{outline:3px solid #a6c78a;outline-offset:3px}
.tool-actions{display:flex;flex-wrap:wrap;gap:.8rem;margin:1.6rem 0 .5rem}.review-result{min-height:1.7rem;font-weight:650}.grid-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.3rem}
@media(max-width:650px){.tool-intro,.grid-2{grid-template-columns:1fr}.tool-meter{max-width:230px}.pass-card{padding:1rem 1rem 1.2rem}.check-row{gap:.65rem;font-size:.98rem}}
@media print {
  @page{size:auto;margin:14mm}
  :global(header),:global(footer),:global(nav),:global(.breadcrumbs),.no-print,.tool-actions,.tool-meter,.review-result{display:none!important}
  .page-head{padding:0!important;margin-bottom:.4rem!important}.page-head h1{font-size:23pt!important}.page-head .lede{font-size:10pt}.privacy{display:none}
  .section{padding:0!important}.pass-card{break-inside:avoid;padding:.3rem .6rem!important;margin:.3rem 0!important;border:1px solid #ccc!important}
  .pass-card legend{font-size:12pt!important}.pass-note{font-size:9pt;margin:0 0 .2rem}
  .check-row{font-size:9pt;padding:.25rem 0!important}.check-row input{width:14px;height:14px;flex-basis:14px}
  .notice{font-size:8pt}
}
</style>
<script>
  const form = document.getElementById('landscape-review-form') as HTMLFormElement | null;
  const boxes = [...(document.querySelectorAll<HTMLInputElement>('.review-check'))];
  const count = document.getElementById('checked-count');
  const progress = document.getElementById('review-progress') as HTMLProgressElement | null;
  const message = document.getElementById('review-result');
  const updateReview = () => {
    const completed = boxes.filter(box => box.checked).length;
    if (count) count.textContent = completed + ' of ' + boxes.length;
    if (progress) progress.value = completed;
    if (message) message.textContent = completed === boxes.length
      ? 'All items have been reviewed. Verify the records and company assumptions before issuing the quote.'
      : completed === 0
        ? 'Start with scope. Tick only what you have checked.'
        : (boxes.length - completed) + ' items remain to review before sending the quote.';
  };
  form?.addEventListener('change', updateReview);
  form?.addEventListener('reset', () => queueMicrotask(updateReview));
  document.getElementById('print-review')?.addEventListener('click', () => window.print());
  updateReview();
</script>
