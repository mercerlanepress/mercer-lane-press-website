---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
const checkoutUrl='https://buy.stripe.com/5kQbJ35UhfKtgeK708ds401';
const schema={'@context':'https://schema.org','@type':'Product',name:'Mercer Lane HR Manager Toolkit + AI Productivity System',description:'A downloadable Excel system for recurring HR administration, with 48 HR AI prompts, 22 editable Word form designs and printable PDFs.',brand:{'@type':'Brand',name:'Mercer Lane Press'},sku:'MLP-HR-TOOLKIT-1-0',image:'https://mercerlanepress.com/images/hr-manager-toolkit/dashboard.png',offers:{'@type':'Offer',url:'https://mercerlanepress.com/tools/hr-manager-toolkit/',priceCurrency:'USD',price:'24.99',availability:'https://schema.org/InStock'}};
const groups=[
 ['People and performance','Employee Directory, HR Dashboard, reviews, goals, one-to-ones and improvement actions.'],
 ['Hiring and onboarding','Recruitment, interview scores, candidate comparison, question planning, onboarding and 30/60/90 plans.'],
 ['Recurring HR operations','Cases, meeting records, training, skills, leave, HR Calendar and a central Actions register.'],
 ['AI productivity','48 HR prompts, AI Prompt Builder, Personal Prompts, Prompt Chaining, input preparation, output review and guided workflows.'],
 ['Editable forms','22 HR form designs in Word, with printable A4 and US Letter versions. Alternate formats are versions of the same designs.'],
 ['Guides and examples','Blank and fictional example workbooks, Start Here, Help / FAQ, advanced help and practical quick references.']
];
---
<BaseLayout title="HR Manager Toolkit for Excel + AI Productivity System" description="Organise recurring HR work with 31 Excel sheets, 48 HR AI prompts and 22 editable form designs. $24.99 USD, one-time purchase." schema={schema}>
 <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Tools',href:'/tools/'},{name:'HR Manager Toolkit'}]}/>
 <header class="page-head wrap hr-hero"><div><p class="eyebrow">EXCEL TOOLS + EDITABLE FORMS + OPTIONAL AI</p><h1>HR Manager Toolkit + AI Productivity System</h1><p class="lede">Keep recurring HR work, records and follow-up organised in one practical Excel system.</p><p>Track employee records, reviews, hiring, onboarding, training and actions. Prepare clearer records with companion forms, guided workflows and optional AI prompts.</p><p class="price">$24.99 <span>USD · one-time purchase</span></p><div class="button-row"><a class="button" href={checkoutUrl} rel="noopener">Buy the complete HR toolkit</a><a class="button button-secondary" href="/free-tools/performance-review-template-excel/">Try the free review starter kit</a></div><p class="fineprint">Digital ZIP download. Microsoft Excel and Word required for editable files. Applicable tax shown at Stripe checkout. The companion book is sold separately.</p></div><figure><img src="/images/hr-manager-toolkit/dashboard.png" alt="Fictional toolkit dashboard showing HR workload and upcoming follow-up" width="1203" height="907" fetchpriority="high"/><figcaption>Inside the toolkit: fictional example dashboard. No real employee data.</figcaption></figure></header>
 <section class="section section-tint"><div class="wrap"><h2>What the complete toolkit adds</h2><div class="grid-3">{groups.map(([head,text])=><article class="card"><h3>{head}</h3><p>{text}</p></article>)}</div></div></section>
 <section class="section"><div class="wrap"><h2>See what you are buying</h2><div class="hr-previews"><figure><img src="/images/hr-manager-toolkit/candidate-comparison.png" alt="Fictional candidate comparison with interview evidence and human decision fields" loading="lazy" width="2174" height="685"/><figcaption>Compare recorded evidence consistently. People make the hiring decision.</figcaption></figure><figure><img src="/images/hr-manager-toolkit/ai-centre.png" alt="AI Productivity Centre with prompt tools and review workflows" loading="lazy" width="1203" height="1022"/><figcaption>Optional AI preparation, reusable prompts and human review.</figcaption></figure></div></div></section>
 <section class="section section-tint"><div class="wrap narrow"><h2>Your download includes</h2><ul><li><strong>Two Excel workbooks:</strong> a blank master and a completed fictional example. Each has 31 sheets.</li><li><strong>22 editable Word form designs:</strong> reviews, goal plans, interview scorecards, onboarding, coaching, meeting records and more.</li><li><strong>A4 and US Letter PDFs:</strong> printable versions of those same 22 forms.</li><li><strong>48 operational HR prompts:</strong> plus prompt building, chaining, input preparation, output review and guided workflows.</li><li><strong>Practical guides:</strong> Start Here, Help / FAQ, advanced help, product contents, quick references and licence terms.</li></ul><p>Save a working copy, configure the reporting date and organisation settings, then choose a workflow. Word forms and PDFs do not populate automatically from Excel; transfer agreed information manually.</p></div></section>
 <section class="section"><div class="wrap narrow"><h2>Free starter kit or complete toolkit?</h2><div class="table-wrap"><table><thead><tr><th scope="col">Your need</th><th scope="col">Choose</th></tr></thead><tbody><tr><td>One employee performance review, goals and an optional prompt</td><td><a href="/free-tools/performance-review-template-excel/">Free review starter kit</a></td></tr><tr><td>Recurring people management, hiring, onboarding and HR actions</td><td>Complete HR Manager Toolkit · $24.99 USD</td></tr></tbody></table></div><h2>Optional AI with human review</h2><p>The tools use Role + Task + Context + Output. The workbook sends nothing to an AI service, needs no API key and makes no automatic employment decisions. Follow your organisation’s AI/privacy policy, minimise confidential information and verify every draft.</p><p><a href="/books/ai-productivity-for-hr-professionals/">AI Productivity for HR Professionals</a> by Mercer Lane explains the wider method and workflows. The book is sold separately and is not needed to use the toolkit.</p></div></section>
 <section class="section section-tint"><div class="wrap narrow"><h2>Before you buy</h2><details><summary>What software is it designed for?</summary><p>Microsoft Excel for the workbooks and Microsoft Word for the editable forms. A PDF reader is sufficient for printable references. No specific desktop version is certified. Excel for Mac and concurrent editing have not been tested. Google Sheets and Apple Numbers are not formally supported. Check a separate working copy in your approved environment.</p></details><details><summary>Can colleagues use it inside my organisation?</summary><p>The supplied licence permits copying and adapting these files for your own internal professional or business work, including sharing working records with authorised colleagues in your organisation. Retain Mercer Lane Press attribution in master templates. Resale, redistribution, sublicensing and distribution to other organisations are not permitted.</p></details><details><summary>How do I receive the download?</summary><p>After Stripe confirms payment, return to the secure download page and save the ZIP. If payment is processing, access begins after it is confirmed. Keep your receipt. If you miss the download page or need help restoring access, email <a href="mailto:mercerlanepress@gmail.com">mercerlanepress@gmail.com</a> using your checkout email address.</p></details><details><summary>Is this an HR compliance or payroll system?</summary><p>It is a general HR administration and productivity resource. It does not replace payroll, an HR information system, access controls, or qualified HR/legal advice. Leave calculations do not create entitlement balances; recurring calendar entries and actions require manual follow-up. Worksheet protection is not encryption.</p></details><details><summary>What about refunds and support?</summary><p>Applicable consumer rights remain in place. Stripe Managed Payments handles checkout transaction support, and Mercer Lane Press can help with product questions. Read <a href="/digital-products/">digital delivery and refund information</a> and <a href="/terms/">site terms</a> before buying.</p></details><div class="notice">General HR productivity resources, not legal, employment-law or jurisdiction-specific compliance advice. Adapt to organisation policy and local requirements. Obtain qualified review where appropriate.</div></div></section>
 <section class="section"><div class="wrap narrow"><h2>Start with a blank copy. Keep follow-up visible.</h2><p class="price">$24.99 <span>USD · one-time purchase</span></p><p><a class="button" href={checkoutUrl} rel="noopener">Buy the HR Manager Toolkit</a></p><p class="fineprint">ZIP download · Internal professional/business use · Applicable tax shown at checkout. By purchasing, you agree to the <a href="/terms/">site terms</a> and supplied product licence. See <a href="/digital-products/">delivery and refund information</a>.</p></div></section>
</BaseLayout>
<style>.hr-hero{display:grid;grid-template-columns:1.05fr 1fr;gap:2.5rem;align-items:center}.hr-hero h1{font-size:clamp(2rem,4vw,3.3rem)}figure{margin:0}figure img{display:block;width:100%;height:auto;border:1px solid var(--line);background:white}figcaption{font-size:.85rem;margin-top:.7rem;color:var(--muted)}.price{font-size:2rem;font-weight:700}.price span{display:block;font-size:.95rem;font-weight:400}.button-row{display:flex;gap:.8rem;flex-wrap:wrap}.fineprint{font-size:.85rem;color:var(--muted)}.hr-previews{display:grid;grid-template-columns:1fr 1fr;gap:2rem}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:1rem;border:1px solid var(--line)}details{padding:1rem 0;border-bottom:1px solid var(--line)}summary{font-weight:700;cursor:pointer}@media(max-width:850px){.hr-hero,.hr-previews{grid-template-columns:1fr}}</style>
