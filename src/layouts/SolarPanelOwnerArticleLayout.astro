---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const { entry } = Astro.props;
const { title, description, published, related } = entry.data;
const url = new URL('/solar-panel-owners/' + entry.id + '/', Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: published.toISOString().slice(0, 10),
  author: { '@type': 'Person', name: 'Gareth Fenwick', url: 'https://mercerlanepress.com/authors/gareth-fenwick/' },
  publisher: { '@type': 'Organization', name: 'Mercer Lane Press', url: 'https://mercerlanepress.com/' },
  mainEntityOfPage: url
};
---
<BaseLayout title={title} description={description} type="article" schema={schema}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Guides',href:'/guides/'},{name:'Solar Panel Owners',href:'/solar-panel-owners/'},{name:title}]}/>
  <article class="article wrap narrow">
    <header>
      <p class="eyebrow">UK SOLAR PANEL OWNER GUIDE</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="byline">By <a href="/authors/gareth-fenwick/">Gareth Fenwick</a> · Published <time datetime={published.toISOString()}>{published.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time></p>
    </header>
    <div class="article-body"><slot /></div>
    <aside class="book-note">
      <p class="eyebrow">THE FULL SOLAR OWNER SYSTEM</p>
      <h2>Understand the paperwork, measurements and next actions together</h2>
      <p><em>Solar Panels Installed — Now What?</em> combines handover checks, export registration, meter and bill reconciliation, tariff decisions, safe troubleshooting, worked cases and reusable owner records in one UK-focused reference.</p>
      <a class="button" href="/books/solar-panels-installed-now-what/">Explore the book</a>
    </aside>
    <nav class="related" aria-label="Related solar panel owner guides">
      <h2>Related solar owner guides</h2>
      <ul>{related.map((slug:string) => <li><a href={'/solar-panel-owners/' + slug + '/'}>{slug.replaceAll('-',' ')}</a></li>)}</ul>
    </nav>
    <p class="notice"><strong>Safety and currency.</strong> These guides cover safe observation and administration, not electrical repairs or installation work. Do not access a roof, open electrical equipment or alter protection settings. Scheme rules and tariffs change; confirm current requirements with the relevant supplier, scheme or qualified professional.</p>
  </article>
</BaseLayout>
