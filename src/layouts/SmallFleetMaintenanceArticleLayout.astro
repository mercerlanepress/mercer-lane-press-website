---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const { entry } = Astro.props;
const { title, description, published, related } = entry.data;
const url = new URL('/small-fleet-maintenance/' + entry.id + '/', Astro.site).href;
const schema = {
  '@context':'https://schema.org',
  '@type':'Article',
  headline:title,
  description,
  datePublished:published.toISOString().slice(0,10),
  author:{'@type':'Person',name:'Warren Holtby',url:'https://mercerlanepress.com/authors/warren-holtby/'},
  publisher:{'@type':'Organization',name:'Mercer Lane Press',url:'https://mercerlanepress.com/'},
  mainEntityOfPage:url
};
---
<BaseLayout title={title} description={description} type="article" schema={schema}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Guides',href:'/guides/'},{name:'Small Fleet Maintenance',href:'/small-fleet-maintenance/'},{name:title}]}/>
  <article class="article wrap narrow">
    <header>
      <p class="eyebrow">SMALL FLEET MAINTENANCE GUIDE</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="byline">By <a href="/authors/warren-holtby/">Warren Holtby</a> · Published <time datetime={published.toISOString()}>{published.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></p>
    </header>
    <div class="article-body"><slot /></div>
    <aside class="book-note">
      <p class="eyebrow">THE COMPLETE SMALL-FLEET SYSTEM</p>
      <h2>Connect maintenance rules, due work, repairs, costs, and review</h2>
      <p><em>The Small Fleet Maintenance Operating Manual</em> brings the vehicle register, source-backed maintenance rules, due-date logic, defect and repair workflow, service history, cost and downtime records, management reviews, spreadsheet design, and 30-day rollout into one operating system.</p>
      <a class="button" href="/books/the-small-fleet-maintenance-operating-manual/">Explore the book</a>
    </aside>
    <nav class="related" aria-label="Related small fleet maintenance guides"><h2>Related small fleet maintenance guides</h2><ul>{related.map((slug:string) => <li><a href={'/small-fleet-maintenance/' + slug + '/'}>{slug.replaceAll('-',' ')}</a></li>)}</ul></nav>
  </article>
</BaseLayout>
