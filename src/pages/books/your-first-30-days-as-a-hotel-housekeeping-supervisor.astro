---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BookCover from '../../components/BookCover.astro';
import GuideCard from '../../components/GuideCard.astro';
import { books } from '../../data/books';

const book = books.find(({slug}) => slug === 'your-first-30-days-as-a-hotel-housekeeping-supervisor')!;
const guides = (await getCollection('hotelHousekeepingSupervisionGuides')).sort((a,b) => a.data.order - b.data.order);
const schema = {
  '@context':'https://schema.org',
  '@type':'Book',
  name:book.title,
  alternativeHeadline:book.subtitle,
  author:{'@type':'Person',name:book.author,url:'https://mercerlanepress.com/authors/julian-rooke/'},
  publisher:{'@type':'Organization',name:book.publisher,url:'https://mercerlanepress.com/'},
  description:book.description,
  url:new URL('/books/' + book.slug + '/',Astro.site).href,
  sameAs:book.purchaseUrl
};
---
<BaseLayout title={book.title} description={book.description} image={book.coverReady ? book.cover : undefined} schema={schema}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Books',href:'/books/'},{name:book.title}]}/>
  <section class="wrap book-layout">
    <BookCover book={book} large/>
    <div>
      <p class="eyebrow">NEW HOTEL HOUSEKEEPING SUPERVISORS</p>
      <h1>{book.title}</h1>
      <p class="lede">{book.subtitle}</p>
      <p>By <a href="/authors/julian-rooke/">Julian Rooke</a> · Published by Mercer Lane Press</p>
      <p>{book.description}</p>
      <div class="actions">
        <a class="button" href={book.purchaseUrl}>Buy on Amazon</a>
        <a class="button button-secondary" href="/hotel-housekeeping-supervision/">Read free guides</a>
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">WHO IT IS FOR</p>
        <h2>For the experienced housekeeper whose job changed when the promotion did</h2>
        <p>{book.intendedReader}</p>
      </div>
      <ul class="check-grid">{book.problems?.map(item => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">THE OPERATING SEQUENCE</p>
        <h2>Read, build, brief, control, check, hand over</h2>
        <p>The book uses one simple sequence to keep the supervisor focused on the whole shift rather than the next room directly in front of them.</p>
      </div>
      <div class="grid-3">
        <article class="card"><h3>Read</h3><p>Start with the actual room picture, current staffing, genuine priorities, late checkouts, known blocks, and supply or equipment risks.</p></article>
        <article class="card"><h3>Build</h3><p>Create workable room boards from the work and people actually available, not from yesterday's forecast or raw room counts alone.</p></article>
        <article class="card"><h3>Brief</h3><p>Tell the team what is different today: workload, priorities, late checkouts, staffing changes, assignment changes, and exceptions.</p></article>
        <article class="card"><h3>Control</h3><p>When reality changes, recount capacity, identify the current bottleneck, rebalance where justified, communicate changes, and escalate gaps that still do not fit.</p></article>
        <article class="card"><h3>Check</h3><p>Inspect against the property's actual standard, distinguish isolated misses from patterns, and follow up repeated defects instead of quietly fixing them forever.</p></article>
        <article class="card"><h3>Hand over</h3><p>Leave unresolved rooms, maintenance, status questions, supply risks, and follow-up actions in a form the next person can continue without reconstructing the shift from memory.</p></article>
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">ROOM BOARDS AND CAPACITY</p>
        <h2>A fair board is more than an equal room count</h2>
        <p>The book separates visible room totals from the operational factors that make one assignment materially harder than another.</p>
      </div>
      <div class="grid-3">
        <article class="card"><h3>Count and workload</h3><p>Departures, stayovers, suites, multiple-bed rooms, special setups, and other legitimate workload differences can make identical room counts misleading.</p></article>
        <article class="card"><h3>Distance and timing</h3><p>Geography, late checkouts, priority arrivals, floor changes, trolley access, and room release times can alter the practical weight of a board.</p></article>
        <article class="card"><h3>Experience and pattern</h3><p>Training level can matter, and supervisors should notice when the same strong employee repeatedly becomes the automatic answer whenever the plan breaks.</p></article>
        <article class="card"><h3>Call-outs change capacity</h3><p>An absence is not simply a missing board to divide among everyone else. The supervisor needs to recount what capacity disappeared before deciding what work can still be protected.</p></article>
        <article class="card"><h3>Do not hide the gap</h3><p>When reasonable rebalancing and authorised support still leave more work than the available team can absorb, the remaining capacity gap should be made visible and escalated.</p></article>
        <article class="card"><h3>Keep asking where work is waiting</h3><p>The bottleneck can move from cleaning to inspection, maintenance, room release, information, linen, or another constraint during the same shift.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">ROOM READINESS AND INSPECTION</p>
        <h2>Know what stage every important room has actually reached</h2>
        <p>A useful operating picture distinguishes rooms that have not started, are in progress, have been cleaned, are waiting for inspection, are blocked, or are genuinely ready.</p>
      </div>
      <div class="grid-3">
        <article class="card"><h3>Watch the queues</h3><p>A large inspection queue can make guests wait even when cleaning progress is reasonable. A group of blocked rooms may point to maintenance rather than housekeeping production.</p></article>
        <article class="card"><h3>Use the approved status system</h3><p>The supervisor's job is not to invent parallel paperwork. It is to keep the hotel's actual source of truth accurate enough for other departments to make decisions.</p></article>
        <article class="card"><h3>Coordinate with front desk</h3><p>For an important room, communicate the current stage, next action, and next useful update instead of promising a completion time that the evidence does not support.</p></article>
        <article class="card"><h3>Inspect consistently</h3><p>Use the property's formal inspection standard and a repeatable route so employees are not guessing what will pass depending on which supervisor enters the room.</p></article>
        <article class="card"><h3>Diagnose repeated defects</h3><p>A repeat miss can be individual, training-related, supply-related, or systemic. Recording enough evidence helps separate memory from a real pattern.</p></article>
        <article class="card"><h3>Give every block a next action</h3><p>Maintenance and other exceptions should have an owner, a next action, appropriate communication, and a recheck point so the room does not disappear from view.</p></article>
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">SUPERVISING PEOPLE</p><h2>Be clear and consistent without turning every correction into a confrontation</h2><p>The transition can be especially awkward when yesterday's coworkers now receive assignments, inspections, and feedback from you.</p></div>
      <div class="grid-3">
        <article class="card"><h3>Explain the work</h3><p>Where an explanation is useful, give the operational reason for a board or priority decision rather than relying on status or authority as the explanation.</p></article>
        <article class="card"><h3>Use observable facts</h3><p>Correct the work that can be described: the missing setup, the visible defect, the board position, or the missed update. Avoid turning a work problem into a personality label.</p></article>
        <article class="card"><h3>Train toward independence</h3><p>Show the approved process, watch the employee perform it, correct specific actions, repeat, and confirm. Taking over may finish today's room without improving tomorrow's performance.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">THE FIRST 30 DAYS</p><h2>Build the role in four stages</h2><p>The month is structured around observation first, then deliberate shift control, recurring-problem diagnosis, communication and coaching, and finally a repeatable supervisor routine.</p></div>
      <div class="hub-steps">
        <article><h3>Days 1–3: understand</h3><p>Clarify decision authority, room-status language, information routes, safety and escalation routes, and where rooms, people, or information regularly wait.</p></article>
        <article><h3>Days 4–7: run deliberately</h3><p>Use the same morning read, fairness check, progress checkpoints, capacity response, front-desk updates, and end-of-shift review across several shifts.</p></article>
        <article><h3>Weeks 2–3: find patterns and coach</h3><p>Look for recurring bottlenecks, test one small improvement at a time, make repeated answers more visible, and follow up coaching instead of treating the conversation as the finish line.</p></article>
        <article><h3>Week 4: build your routine</h3><p>Create deliberate control points through the day, recognise common escalation triggers, review the 30-day scorecard, and choose a small number of Month 2 capabilities to practise.</p></article>
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">FIELD MANUAL</p><h2>Reusable sheets for the moments that create pressure</h2><p>The final section condenses the operating ideas into quick-reference checks and working sheets.</p></div>
      <div class="grid-3">
        <article class="card"><h3>Morning and room-flow control</h3><p>Morning House Read, room-board check, call-out decision tree, room-flow check, and blocked-room record.</p></article>
        <article class="card"><h3>Daily supervisor control</h3><p>A compact place to track staffing, priorities, the largest queue, inspection concerns, blocked rooms, supply risks, board changes, updates owed, and coaching follow-up.</p></article>
        <article class="card"><h3>Inspection, feedback, and training</h3><p>Repeatable inspection steps, quick feedback structures, a training loop, linen-shortage checks, and an exception sequence for issues that need the property's formal process.</p></article>
        <article class="card"><h3>End-of-shift handover</h3><p>A structured handover for unresolved priorities, unfinished rooms, blocked rooms, maintenance, supply or equipment risks, status questions, employee follow-up, and the first action for the next supervisor.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">FREE SUPPORTING GUIDES</p><h2>Focused help for common housekeeping-supervisor problems</h2><p>These guides pull six practical problems out of the wider operating system so readers can start with the issue happening on today's shift.</p></div>
      <div class="grid-3">{guides.map(guide => <GuideCard guide={guide} base="/hotel-housekeeping-supervision/" label="HOTEL HOUSEKEEPING" />)}</div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap narrow">
      <div class="section-head"><p class="eyebrow">PROPERTY-SPECIFIC PROCEDURES COME FIRST</p><h2>A field guide does not replace the hotel's own standards or authority structure</h2></div>
      <p>The book is an independent practical guide. Hotels vary in staffing models, room types, productivity expectations, inspection standards, systems, cleaning products, security procedures, management structures, and employment requirements.</p>
      <div class="notice"><strong>Follow the procedures that apply to your property.</strong> Use employer-approved rules and training for cleaning chemicals, personal protective equipment, contaminated materials, sharps, guest property, security incidents, injuries, safety matters, formal HR action, and other issues where the hotel's procedures or applicable requirements govern the response.</div>
    </div>
  </section>
</BaseLayout>
