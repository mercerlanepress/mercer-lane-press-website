---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const { entry } = Astro.props;
const { title, description, published, related } = entry.data;
const url = new URL('/dog-enrichment/' + entry.id + '/', Astro.site).href;
const schema = {
  '@context':'https://schema.org',
  '@type':'Article',
  headline:title,
  description,
  datePublished:published.toISOString().slice(0,10),
  author:{'@type':'Person',name:'Sophie Ardenwood',url:'https://mercerlanepress.com/authors/sophie-ardenwood/'},
  publisher:{'@type':'Organization',name:'Mercer Lane Press',url:'https://mercerlanepress.com/'},
  mainEntityOfPage:url
};
---
<BaseLayout title={title} description={description} type="article" schema={schema}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Dog Enrichment',href:'/dog-enrichment/'},{name:title}]}/>
  <article class="article wrap narrow">
    <header>
      <p class="eyebrow">DOG ENRICHMENT GUIDE</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="byline">By <a href="/authors/sophie-ardenwood/">Sophie Ardenwood</a> · Published <time datetime={published.toISOString()}>{published.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></p>
    </header>
    <div class="article-body"><slot /></div>
    <aside class="book-note">
      <p class="eyebrow">DOG ENRICHMENT BOOKS</p>
      <h2>Turn useful ideas into a repeatable routine</h2>
      <p><em>Dog Enrichment for Apartments & Busy Owners</em> focuses on quiet, small-space activities and busy-day routines. <em>Busy Dog, Better Day</em> provides a broader 60-game activity library for ordinary days.</p>
      <div class="actions">
        <a class="button" href="/books/dog-enrichment-for-apartments-and-busy-owners/">Apartment & busy-owner guide</a>
        <a class="button button-secondary" href="/books/busy-dog-better-day/">Broader activity library</a>
      </div>
    </aside>
    <nav class="related" aria-label="Related guides"><h2>Related dog enrichment guides</h2><ul>{related.map((slug:string) => <li><a href={'/dog-enrichment/' + slug + '/'}>{slug.replaceAll('-',' ')}</a></li>)}</ul></nav>
  </article>
</BaseLayout>
