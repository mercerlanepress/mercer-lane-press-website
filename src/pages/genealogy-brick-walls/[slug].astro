---
import { getCollection, render } from 'astro:content';
import GenealogyBrickWallArticleLayout from '../../layouts/GenealogyBrickWallArticleLayout.astro';

export async function getStaticPaths(){
  return (await getCollection('genealogyBrickWallGuides')).map(entry => ({params:{slug:entry.id},props:{entry}}));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<GenealogyBrickWallArticleLayout entry={entry}><Content /></GenealogyBrickWallArticleLayout>
