---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import {authors} from '../../data/authors'; import {books} from '../../data/books'; const author=authors[0]; const authoredBooks=books.filter(book=>book.authorSlug===author.slug); const schema={'@context':'https://schema.org','@type':'Person',name:author.name,url:'https://mercerlanepress.com/authors/mercer-lane/',description:author.bio};
---
<BaseLayout title="Mercer Lane, Author" description="Mercer Lane is the author name used for practical nonfiction published by Mercer Lane Press." schema={schema}><Breadcrumbs items={[{name:'Home',href:'/'},{name:'Authors',href:'/authors/'},{name:author.name}]}/><header class="page-head wrap prose"><p class="eyebrow">AUTHOR</p><h1>{author.name}</h1><p class="lede">{author.bio}</p></header><section class="section section-tint"><div class="wrap prose"><h2>Books by Mercer Lane</h2>{authoredBooks.map(book=><article><h3><a href={`/books/${book.slug}/`}>{book.title}</a></h3><p>{book.description}</p><a class="button" href={`/books/${book.slug}/`}>Explore the book</a></article>)}</div></section></BaseLayout>
