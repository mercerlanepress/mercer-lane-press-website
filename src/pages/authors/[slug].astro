---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { authors, type Author } from '../../data/authors';
import { books } from '../../data/books';
export function getStaticPaths() { return authors.filter(({slug}) => slug !== 'mercer-lane').map(author => ({params:{slug:author.slug},props:{author}})); }
const { author } = Astro.props as { author: Author };
const authoredBooks = books.filter(book => book.authorSlug === author.slug);
const schema={'@context':'https://schema.org','@type':'Person',name:author.name,url:`https://mercerlanepress.com/authors/${author.slug}/`,description:author.bio,...(author.sameAs ? {sameAs:[author.sameAs]} : {})};
---
<BaseLayout title={`${author.name}, Author`} description={author.bio} schema={schema}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Authors',href:'/authors/'},{name:author.name}]}/>
  <header class="page-head wrap prose"><p class="eyebrow">AUTHOR</p><h1>{author.name}</h1><p class="lede">{author.bio}</p>{author.slug === 'sophie-ardenwood' && <div class="actions"><a class="button button-secondary" href="/dog-guides/">Browse Sophie Ardenwood dog guides</a></div>}{author.slug === 'evan-hargreaves' && <div class="actions"><a class="button button-secondary" href="/beginner-telescope-observing/">Browse beginner telescope observing guides</a><a class="button button-secondary" href="/deep-sky-astrophotography/">Browse deep-sky astrophotography guides</a></div>}{author.slug === 'warren-holtby' && <div class="actions"><a class="button button-secondary" href="/construction-estimating/">Browse construction estimating guides</a><a class="button button-secondary" href="/landscape-contractor-estimating/">Browse landscape estimating guides</a><a class="button button-secondary" href="/epa-608-universal-exam/">Browse EPA 608 Universal exam guides</a></div>}{author.slug === 'lewis-hartfield' && <div class="actions"><a class="button button-secondary" href="/home-assistant-matter-thread/">Browse Home Assistant, Matter &amp; Thread guides</a></div>}{author.slug === 'daniel-mercer' && <div class="actions"><a class="button button-secondary" href="/genealogy-brick-walls/">Browse genealogy brick-wall guides</a><a class="button button-secondary" href="/maintenance-planning/">Browse maintenance planning guides</a></div>}{author.slug === 'julian-rooke' && <div class="actions"><a class="button button-secondary" href="/pickleball-doubles/">Browse pickleball doubles strategy guides</a></div>}{author.slug === 'grant-ellwood' && <div class="actions"><a class="button button-secondary" href="/youth-soccer-coaching/">Browse volunteer youth soccer coaching guides</a></div>}{author.slug === 'aaron-bellcroft' && <div class="actions"><a class="button button-secondary" href="/ham-radio-technician-exam/">Browse Ham Radio Technician exam guides</a></div>}{author.slug === 'james-carter' && <div class="actions"><a class="button button-secondary" href="/first-year-homeowner/">Browse first-year homeowner maintenance guides</a></div>}</header>
  <section class="section section-tint"><div class="wrap prose"><h2>Books by {author.name}</h2>{authoredBooks.map(book => <article><h3><a href={`/books/${book.slug}/`}>{book.title}</a></h3><p>{book.description}</p><a class="button" href={`/books/${book.slug}/`}>Explore the book</a></article>)}</div></section>
</BaseLayout>
