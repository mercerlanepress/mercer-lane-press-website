---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const { entry } = Astro.props;
const { title, description, published, related } = entry.data;
const url = new URL('/family-admin/' + entry.id + '/', Astro.site).href;
const schema = {
  '@context':'https://schema.org',
  '@type':'Article',
  headline:title,
  description,
  datePublished:published.toISOString().slice(0,10),
  author:{'@type':'Person',name:'Mercer Lane',url:'https://mercerlanepress.com/authors/mercer-lane/'},
  publisher:{'@type':'Organization',name:'Mercer Lane Press',url:'https://mercerlanepress.com/'},
  mainEntityOfPage:url
};
---
<BaseLayout title={title} description={description} type="article" schema={schema}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Guides',href:'/guides/'},{name:'Family Admin',href:'/family-admin/'},{name:title}]}/>
  <article class="article wrap narrow">
    <header>
      <p class="eyebrow">FAMILY ADMIN GUIDE</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="byline">By <a href="/authors/mercer-lane/">Mercer Lane</a> · Published <time datetime={published.toISOString()}>{published.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></p>
    </header>
    <div class="article-body"><slot /></div>
    <aside class="book-note">
      <p class="eyebrow">THE COMPLETE FAMILY ADMIN SYSTEM</p>
      <h2>Build a household system you can review and maintain</h2>
      <p><em>Stop Drowning in Family Admin</em> combines a five-stage workflow, a short weekly reset, follow-up tracking, findable records, explicit handoffs, a 30-day rollout, implementation playbooks, worked scenarios, and reusable household worksheets.</p>
      <a class="button" href="/books/stop-drowning-in-family-admin/">Explore the book</a>
    </aside>
    <nav class="related" aria-label="Related family admin guides"><h2>Related family admin guides</h2><ul>{related.map((slug:string) => <li><a href={'/family-admin/' + slug + '/'}>{slug.replaceAll('-',' ')}</a></li>)}</ul></nav>
  </article>
</BaseLayout>
