---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';
export async function getStaticPaths(){const guides=await getCollection('hrAiGuides');return guides.map(guide=>({params:{slug:guide.id},props:{guide}}));}
const {guide}=Astro.props; const {Content}=await render(guide);
---
<GuideLayout guide={guide} base="/hr-ai/" hubLabel="AI for HR Professionals Guides"><Content /></GuideLayout>