---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
const schema={'@context':'https://schema.org','@type':'WebApplication',name:'Fleet Maintenance Due Date & Mileage Calculator',url:'https://mercerlanepress.com/tools/fleet-maintenance-due-calculator/',applicationCategory:'BusinessApplication',operatingSystem:'Web browser',isAccessibleForFree:true,description:'Calculate one maintenance item by a verified date interval, mileage interval or whichever comes first.'};
---
<BaseLayout title="Fleet Maintenance Schedule Calculator | Due by Date or Mileage" description="Free fleet maintenance calculator for one verified service rule. Check next due date, mileage, days and miles remaining, including missing or stale data." schema={schema} sensitiveTool={true}>
 <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Tools',href:'/tools/'},{name:'Fleet maintenance calculator'}]}/>
 <header class="wrap calculator-head"><p class="eyebrow">FREE TOOL · NO ACCOUNT REQUIRED</p><h1>Fleet Maintenance Due Date &amp; Mileage Calculator</h1><p>Check one maintenance item using the verified interval for your vehicle. Enter date, mileage or both.</p></header>
 <div class="wrap calculator-grid">
 <form id="fleet-calculator" autocomplete="off" aria-describedby="source-help">
  <p id="source-help"><strong>Use the interval from the current manufacturer schedule, owner's information, warranty/service information or other appropriate verified source for your specific vehicle.</strong> No generic service interval is supplied.</p>
  <div class="fields"><label>Unit ID or vehicle label <span>(optional)</span><input name="unit" maxlength="80"/></label><label>Maintenance item <span>(optional)</span><input name="item" maxlength="120"/></label></div>
  <label for="trigger">This requirement is due by</label><select id="trigger" name="trigger"><option value="dual">Date or mileage, whichever comes first</option><option value="date">Date only</option><option value="miles">Mileage only</option></select>
  <fieldset data-date><legend>Date trigger</legend><div class="fields"><label>Last completed service date<input name="lastDate" type="date"/></label><label>Verified interval in calendar months<input name="intervalMonths" type="number" min="1" max="1200" step="1"/></label><label>Due-soon warning days<input name="warningDays" type="number" min="0" step="1" value="30"/></label></div></fieldset>
  <fieldset data-mileage><legend>Mileage trigger</legend><div class="fields"><label>Last completed service mileage<input name="lastMileage" type="number" min="0" step="any"/></label><label>Current mileage<input name="currentMileage" type="number" min="0" step="any"/></label><label>Current mileage reading date<input name="readingDate" type="date"/></label><label>Verified interval in miles<input name="intervalMiles" type="number" min="0" step="any"/></label><label>Due-soon warning miles<input name="warningMiles" type="number" min="0" step="any" value="1000"/></label><label>Mileage freshness threshold days <span>(optional)</span><input name="freshnessDays" type="number" min="0" step="1" aria-describedby="fresh-help"/></label></div><p id="fresh-help">Blank means no freshness check. Choose a maximum age that suits your operation. No mileage is estimated.</p></fieldset>
  <label class="check"><input name="sourceVerified" type="checkbox"/> I have verified this vehicle's interval from an appropriate source.</label>
  <p class="small">Warning windows are editable administrative choices, not service intervals or permission to delay work. Values stay in this page. They are not stored or sent.</p>
  <button class="button button-secondary" type="reset">Reset calculator</button>
 </form>
 <div><section id="fleet-result" class="result" aria-live="polite" aria-atomic="true"><p class="eyebrow">RESULT AS OF <span id="asof"></span></p><h2 id="overall-status">DATA ISSUE</h2><p id="explanation">Enter the required source and service details.</p><dl class="result-grid"><div><dt>Next due date</dt><dd id="due-date">Not calculated</dd></div><div><dt>Next due mileage</dt><dd id="due-mileage">Not calculated</dd></div><div><dt>Days remaining</dt><dd id="days-left">Not calculated</dd></div><div><dt>Miles remaining</dt><dd id="miles-left">Not calculated</dd></div><div><dt>Date status</dt><dd id="date-status">DATA ISSUE</dd></div><div><dt>Mileage status</dt><dd id="mileage-status">DATA ISSUE</dd></div></dl><p><strong>Controlling urgency:</strong> <span id="controlling">Resolve data first</span></p><ul id="issues"></ul><div class="result-actions"><button id="copy-result" type="button" class="button button-secondary" disabled>Copy result</button><button id="print-result" type="button" class="button button-secondary">Print result</button></div><p id="copy-message" role="status"></p></section>
 <aside class="product-cta"><h2>Managing this across several vehicles?</h2><p>The Small Fleet Maintenance System connects multiple rules, mileage history, defects/actions, repair authorization, service history, costs, downtime, audit checks and a dashboard for 3–50 vehicles.</p><p><a class="button" href="/tools/small-fleet-maintenance-system/" data-fleet-product>Get the Small Fleet Maintenance System</a></p><p><a href="https://www.amazon.com/dp/B0HM33JJL6" data-fleet-book>Read The Small Fleet Maintenance Operating Manual</a></p></aside></div>
 </div>
 <noscript><p class="wrap notice">Enable JavaScript to calculate. The explanations below remain available.</p></noscript>
 <section class="section section-tint"><div class="wrap narrow prose"><h2>How due dates and mileage work together</h2><p>For a mileage rule, next due mileage is the last verified completion mileage plus the vehicle's source interval. For a date rule, next due date is the last verified completion date plus calendar months. Month-end dates use the final valid day of the destination month.</p><p>For a dual trigger, whichever becomes due first controls. The date and mileage statuses stay separate so you can see the reason for urgency. The exact due point counts as OVERDUE in this calculator.</p><h2>Warnings and missing data</h2><p>DUE SOON means a trigger is inside your chosen warning window. It gives the office time to plan. It does not change the verified requirement. DATA ISSUE takes priority when a required baseline, source confirmation, reading or date is missing, invalid or stale under your chosen standard.</p><h2>A booking does not reset maintenance</h2><p>Use the actual completed service date and mileage to reset the next due points. Booking a visit, receiving a quote or passing the appointment date does not prove work was completed. Keep completion evidence and reset only the requirements that the work satisfied.</p><h2>When a fleet spreadsheet helps</h2><p>This tool handles one item at a time. A <a href="/tools/small-fleet-maintenance-system/">connected fleet workbook</a> becomes useful when several vehicles have different requirements and you need owners, open defects, approvals, documents, costs and downtime in the same operating process.</p></div></section>
 <section class="section"><div class="wrap narrow prose"><h2>Frequently asked questions</h2>
 <details><summary>What if service is due by both mileage and date?</summary><p>Choose the dual-trigger option and enter both verified intervals and baselines. The most urgent applicable state controls. Missing required data takes priority over CURRENT.</p></details>
 <details><summary>Why doesn't the calculator tell me my vehicle's service interval?</summary><p>Requirements depend on the specific vehicle, specification, use, warranty and authoritative information. A generic interval could be wrong. Obtain the current requirement from an appropriate verified source.</p></details>
 <details><summary>What does DATA ISSUE mean?</summary><p>A required source confirmation, completion baseline, current reading, date or other critical value is unusable. Review the explanation and obtain the missing evidence. It is not a diagnosis of vehicle condition.</p></details>
 <details><summary>Does a booked appointment mean the vehicle is no longer overdue?</summary><p>No. A booking is an action. The item remains overdue until the required work is completed and the supported completion baseline is entered.</p></details>
 <details><summary>Can I use this calculator for multiple vehicles?</summary><p>You can reset and calculate another vehicle or item. It does not retain a fleet register. For recurring control, see the <a href="/tools/small-fleet-maintenance-system/">Small Fleet Maintenance System</a>.</p></details>
 <details><summary>Does this replace the manufacturer's service schedule?</summary><p>No. It applies the intervals you supply. It does not create service requirements, diagnose faults, certify safety or replace legally required inspection, reporting or compliance systems.</p></details>
 <p class="small">Methodology: <a href="/books/the-small-fleet-maintenance-operating-manual/">The Small Fleet Maintenance Operating Manual</a> by Warren Holtby, Mercer Lane Press, chapter 4. Use appropriate manufacturer, official and qualified sources for technical and safety decisions.</p></div></section>
</BaseLayout>
<script>import {mountCalculator} from '../../../scripts/fleet-due.mjs';mountCalculator();</script>
<style>
.calculator-head{padding:1.5rem 0 1rem}.calculator-head h1{font-size:clamp(2rem,3.7vw,3rem);max-width:900px}.calculator-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:2rem;align-items:start}form{border:1px solid var(--line);padding:1.5rem;background:var(--paper)}.fields{display:grid;grid-template-columns:1fr 1fr;gap:.7rem 1rem}label{display:block;font-size:.94rem;font-weight:650}label span,.small,#fresh-help{font-size:.85rem;font-weight:400;color:var(--muted)}input,select{display:block;width:100%;min-height:42px;padding:.55rem;border:1px solid #8b99a8;border-radius:2px;font:inherit;background:white;color:var(--ink)}select{margin:.5rem 0 1rem}input:focus-visible,select:focus-visible,button:focus-visible{outline:3px solid var(--cyan);outline-offset:2px}fieldset{border:0;padding:0;margin:1rem 0}legend{font-weight:750;margin-bottom:.5rem}.check{display:flex;gap:.6rem;align-items:flex-start;margin:1rem 0}.check input{width:20px;min-height:20px;margin-top:3px;flex-shrink:0}.result{border:1px solid var(--line);border-top:5px solid var(--cyan);padding:1.5rem}.result[data-status="DATA ISSUE"],.result[data-status="OVERDUE"]{border-top-color:#a22e2e}.result[data-status="DUE SOON"]{border-top-color:#a56c0b}.result h2{font-family:var(--sans);font-size:1.6rem}.result-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.result-grid dt{font-size:.85rem;color:var(--muted)}.result-grid dd{margin:0;font-weight:700}.result-actions{display:flex;gap:.6rem;flex-wrap:wrap}button{font:inherit;cursor:pointer}button:disabled{opacity:.6;cursor:default}.product-cta{margin-top:1rem;padding:1.5rem;background:var(--paper)}.product-cta h2{font-size:1.45rem}details{border-bottom:1px solid var(--line);padding:1rem 0}summary{font-weight:700;cursor:pointer}details p{margin-top:.8rem}@media(max-width:800px){.calculator-grid{grid-template-columns:1fr}}@media(max-width:420px){.fields{grid-template-columns:1fr}}@media print{:global(.site-header),:global(.site-footer),:global(.consent-banner),form,.product-cta,.result-actions{display:none!important}.calculator-grid{display:block}.result{break-inside:avoid}:global(.section){display:none}}
</style>
