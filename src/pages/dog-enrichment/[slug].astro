---
import { getCollection, render } from 'astro:content';
import DogEnrichmentArticleLayout from '../../layouts/DogEnrichmentArticleLayout.astro';

export async function getStaticPaths(){
  return (await getCollection('dogEnrichmentGuides')).map(entry => ({params:{slug:entry.id},props:{entry}}));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<DogEnrichmentArticleLayout entry={entry}><Content /></DogEnrichmentArticleLayout>
