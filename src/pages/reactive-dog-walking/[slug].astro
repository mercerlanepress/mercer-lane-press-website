---
import { getCollection, render } from 'astro:content';
import ReactiveDogArticleLayout from '../../layouts/ReactiveDogArticleLayout.astro';

export async function getStaticPaths(){
  return (await getCollection('reactiveDogWalkingGuides')).map(entry => ({params:{slug:entry.id},props:{entry}}));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<ReactiveDogArticleLayout entry={entry}><Content /></ReactiveDogArticleLayout>
