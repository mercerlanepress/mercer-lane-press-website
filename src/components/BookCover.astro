---
import coverDimensions from '../data/book-cover-dimensions.json';
const { book, large = false, eager = false, homepageHero = false } = Astro.props;
// Keep these intrinsic dimensions in sync when adding or replacing a cover.
const dimensions = coverDimensions[book.cover as keyof typeof coverDimensions];
if (book.coverReady && !dimensions) {
  throw new Error(`Missing intrinsic dimensions for book cover: ${book.cover}`);
}
const homeCover = '/images/books/The_Small_Fleet_Maintenance_Front_Cover.jpg';
if (homepageHero && (!book.coverReady || book.cover !== homeCover)) {
  throw new Error('Homepage WebP variants must be regenerated and reviewed when the featured book changes.');
}
const homeCoverBase = homeCover.slice(0, -4);
---
<div class:list={['cover-shell', large && 'cover-large']}>
  {book.coverReady
    ? homepageHero
      ? <picture>
          <source type="image/webp"
            srcset={`${homeCoverBase}-480.webp 480w, ${homeCoverBase}-800.webp 800w`}
            sizes="(max-width: 720px) 260px, 360px" />
          <img src={book.cover} alt={'Cover of ' + book.title + ' by ' + book.author}
            width={dimensions?.width} height={dimensions?.height}
            loading="eager" fetchpriority="high" />
        </picture>
      : <img src={book.cover} alt={'Cover of ' + book.title + ' by ' + book.author}
          width={dimensions?.width} height={dimensions?.height}
          loading={large || eager ? 'eager' : 'lazy'} fetchpriority={large || eager ? 'high' : undefined} />
    : <div class="cover-placeholder" role="img" aria-label={'Placeholder cover for ' + book.title}>
        <small>MERCER LANE PRESS</small><h2>{book.title}</h2><p>{book.topics?.[0] ?? 'Practical guide'}</p><strong>{book.author}</strong>
      </div>}
</div>
